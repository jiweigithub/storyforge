+    const row = value as Record<string, unknown>
+    if (Object.keys(required).some(key => !hasOwn(row, key))
+      || Object.keys(row).some(key => !hasOwn(required, key) && !hasOwn(optional, key))) {
+      narrativeFail('exact-keys', `${path} 缺少字段或含额外字段`)
+    }
+    return Object.fromEntries(Object.keys(row).map(key => [key, (required[key] ?? optional[key])(row[key], `${path}.${key}`)])) as T
+  }
+}
+
+const visibility: DecoderV1<VisibilityV1> = (value, path) => {
+  const decoded = objectV1<VisibilityV1>({ class: enumV1(['public', 'restricted', 'author-only', 'unclassified'] as const),
+    audienceKeys: uniqueKeysV1, policyVersion: keyV1 })(value, path)
+  if (decoded.class === 'restricted' ? decoded.audienceKeys.length === 0 : decoded.audienceKeys.length !== 0) {
+    narrativeFail('visibility', `${path} 分类与受众不一致`)
+  }
+  return decoded
+}
+const authority = objectV1<NarrativeDomainAuthorityV1>({ version: enumV1([1] as const), confirmationUid: keyV1,
+  mode: enumV1(['author-declaration', 'candidate-adoption'] as const), confirmedAt: uintV1, contentHash: hashV1 })
+
+function decoders(coordinate: 'local' | 'portable') {
+  const source = <K extends NarrativeSourceFkV1>(allowed: readonly K[]): DecoderV1<NarrativeDomainSourceRefV1<K>> => (value, path) => {
+    if (!value || typeof value !== 'object' || Array.isArray(value)) narrativeFail('source-ref', `${path} 不是分类型来源引用`)
+    const fields = Object.keys(value), field = fields.find(key => allowed.includes(key as K)) as K | undefined
+    if (!field || fields.length !== 2 || !fields.includes('sourceUid')) narrativeFail('source-ref', `${path} 必须且只能含一个登记 FK 和 sourceUid`)
+    const row = value as Record<string, unknown>
+    const uid = keyV1(row.sourceUid, `${path}.sourceUid`)
+    if (!isPortableResourceUidV1(uid, NARRATIVE_SOURCE_FKS_V1[field].resourceKind)) narrativeFail('source-uid', `${path} UID 与 FK 来源不一致`)
+    const id = row[field] === null ? null : uintV1(row[field], `${path}.${field}`)
+    if (id !== null && coordinate === 'local' && id === 0) narrativeFail('source-ref', `${path} 本地主键必须为正整数`)
+    return { [field]: id, sourceUid: uid } as NarrativeDomainSourceRefV1<K>
+  }
+  const anySource = source(sourceFkKeys)
+  const entity = source(['characterId', 'locationId', 'codexEntryId', 'worldGroupId'])
+  const atom = <K extends SemanticKindV1>(kinds: readonly K[]): DecoderV1<NarrativeDomainAtomRefV1<K>> => (value, path) => {
+    const parsed = objectV1<NarrativeDomainAtomRefV1<K>>({ kind: enumV1(kinds), source: anySource,
+      subKey: (key, at) => key === 'root' ? 'root' : subKeyV1(key, at) })(value, path)
+    const fk = sourceFkKeys.find(key => key in parsed.source)!
+    if (!(NARRATIVE_SOURCE_FKS_V1[fk].semanticKinds as readonly SemanticKindV1[]).includes(parsed.kind)) {
+      narrativeFail('ref-kind', `${path} FK 目标不支持 ${parsed.kind}`)
+    }
+    if (parsed.kind === 'disclosure' && parsed.subKey === 'root') narrativeFail('subkey', `${path} 揭示标注需要稳定子记录身份`)
+    return parsed
+  }
+  const anyAtom = atom(NARRATIVE_KINDS_V1), event = atom(['event']), assertion = atom(['assertion'])
+  const typedValue: DecoderV1<NarrativeDomainValueV1> = (value, path) => {
+    switch ((value as NarrativeDomainValueV1 | null)?.kind) {
+      case 'boolean': return objectV1({ kind: enumV1(['boolean'] as const), value: (item, at) => {
+        if (typeof item !== 'boolean') narrativeFail('shape', `${at} 必须是 boolean`)
+        return item
+      } })(value, path)
+      case 'text': return objectV1({ kind: enumV1(['text'] as const), value: textV1 })(value, path)
+      case 'enum': return objectV1({ kind: enumV1(['enum'] as const), value: keyV1 })(value, path)
+      case 'decimal': return objectV1({ kind: enumV1(['decimal'] as const), unit: nullableV1(keyV1), value: (item, at) => {
+        const text = textV1(item, at)
+        if (!/^-?(0|[1-9][0-9]*)(\.[0-9]*[1-9])?$/.test(text) || text === '-0') narrativeFail('decimal', `${at} 必须是规范十进制字符串`)
+        return text
+      } })(value, path)
+      case 'entity-ref': return objectV1({ kind: enumV1(['entity-ref'] as const), value: entity })(value, path)
+      case 'ordered-set': {
+        const set = objectV1({ kind: enumV1(['ordered-set'] as const), values: arrayV1(typedValue) })(value, path)
+        if (set.values.some(item => item.kind === 'ordered-set')) narrativeFail('value-depth', `${path} 不允许嵌套有序集合`)
+        if (new Set(set.values.map(canonicalNarrativeJsonV1)).size !== set.values.length) narrativeFail('duplicate', `${path} 有序集合重复`)
+        return set as NarrativeDomainValueV1
+      }
+      default: return narrativeFail('value-kind', `${path} 不支持的值类型`)
+    }
+  }
+  const point: DecoderV1<NarrativeDomainTimePointV1> = (value, path) => {
+    switch ((value as NarrativeDomainTimePointV1 | null)?.kind) {
+      case 'tick': return objectV1({ kind: enumV1(['tick'] as const), timelineKey: keyV1, value: integerTextV1 })(value, path)
+      case 'unknown': return objectV1({ kind: enumV1(['unknown'] as const), label: nullableV1(textV1) })(value, path)
+      case 'event-anchor': return objectV1({ kind: enumV1(['event-anchor'] as const), event, side: enumV1(['before', 'at', 'after'] as const) })(value, path)
+      default: return narrativeFail('time-point', `${path} 不支持的时间点`)
+    }
+  }
+  const interval: DecoderV1<NarrativeDomainIntervalV1> = (value, path) => {
+    const parsed = objectV1<NarrativeDomainIntervalV1>({ start: point, end: nullableV1(point), endMeaning: enumV1(['known', 'open', 'unknown'] as const) })(value, path)
+    if ((parsed.endMeaning === 'known') !== (parsed.end !== null)) narrativeFail('time-interval', `${path} 终点含义不一致`)
+    return parsed
+  }
+  const chapter = source(['chapterId'])
+  const time = objectV1<NarrativeDomainTimeV1>({ occurred: nullableV1(interval), valid: nullableV1(interval), acquiredAt: nullableV1(point),
+    narratedAt: nullableV1(objectV1({ chapter, spanStart: uintV1 })), disclosedAt: arrayV1(objectV1({ audienceKey: keyV1, chapter })) })
+  const evidence = objectV1<NarrativeDomainEvidenceV1>({ evidenceKey: keyV1, source: (value, path) => {
+    if (value && typeof value === 'object' && 'self' in value) return objectV1({ self: (item, at) => {
+      if (item !== true) narrativeFail('source-ref', `${at} 必须为 true`)
+      return true as const
+    } })(value, path)
+    return anySource(value, path)
+  }, fieldPointer: pointerV1, sourceContentHash: hashV1, normalizationVersion: enumV1(['raw-utf8-v1'] as const),
+  start: uintV1, end: uintV1, spanHash: hashV1, supportRole: enumV1(['supports', 'contradicts', 'context'] as const) })
+  const dependency = objectV1<NarrativeDomainDependencyV1>({ target: anyAtom,
+    role: enumV1(['supports', 'contradicts', 'derived-from', 'causes', 'requires'] as const), evidenceKeys: uniqueKeysV1 })
+  const metadata: { [K in keyof Required<NarrativeDomainMetadataV1>]: DecoderV1<NonNullable<NarrativeDomainMetadataV1[K]>> } = {
+    narrativeTimeV1: time, narrativeEvidenceV1: keyedArray(evidence, item => item.evidenceKey), narrativeVisibilityV1: visibility,
+    narrativeModalityV1: enumV1(['established', 'belief', 'intent'] as const), narrativeDependenciesV1: arrayV1(dependency), narrativeAuthorityV1: authority,
+  }
+  const eventPayload: DecoderV1<NarrativeDomainEventV1> = (value, path) => {
+    const parsed = objectV1<NarrativeDomainEventV1>({ eventType: enumV1(['action', 'observation', 'communication'] as const),
+      participants: arrayV1(objectV1({ entity, role: keyV1 })), locations: arrayV1(source(['locationId'])),
+      propositions: arrayV1(assertion), effects: arrayV1(anyAtom), before: arrayV1(event), observer: nullableV1(entity),
+      communication: nullableV1(objectV1({ sender: entity, recipients: arrayV1(entity), channel: keyV1 })) })(value, path)
+    if ((parsed.eventType === 'observation') !== (parsed.observer !== null)
+      || (parsed.eventType === 'communication') !== (parsed.communication !== null)
+      || parsed.communication?.recipients.length === 0) narrativeFail('event-variant', `${path} 观察/通信类型与字段不一致`)
+    return parsed
+  }
+  const epistemic: DecoderV1<NarrativeDomainEpistemicV1> = (value, path) => {
+    const parsed = objectV1<NarrativeDomainEpistemicV1>({ attitude: enumV1(['know', 'believe', 'doubt', 'unaware'] as const),
+      transition: enumV1(['acquire', 'revise', 'forget', 'deny-awareness'] as const), assertedValue: typedValue,
+      sourceEvent: nullableV1(event), revises: nullableV1(source(['knowledgeId'])) })(value, path)
+    if ((parsed.transition === 'revise') !== (parsed.revises !== null)
+      || (parsed.transition === 'deny-awareness' && parsed.attitude !== 'unaware')) narrativeFail('epistemic-transition', `${path} 认知修订结构不闭合`)
+    return parsed
+  }
+  const { narrativeAuthorityV1: _parentAuthority, ...childMetadata } = metadata
+  const development = optionalObject<NarrativeDomainDevelopmentV1>({ semanticSubKey: subKeyV1, statement: textV1,
+    developmentType: enumV1(['thread', 'goal', 'conflict', 'commitment', 'foreshadow'] as const), owners: arrayV1(entity), members: arrayV1(anyAtom),
+    state: enumV1(['open', 'advancing', 'blocked', 'resolved', 'fulfilled', 'abandoned'] as const), transitions: arrayV1(event), resolutionEvidenceKeys: uniqueKeysV1 }, childMetadata)
+  const disclosure = optionalObject<NarrativeDomainDisclosureV1>({ semanticSubKey: subKeyV1,
+    subjects: arrayV1(anyAtom), audienceKeys: uniqueKeysV1, evidenceKey: keyV1 }, childMetadata)
+  const chronology = objectV1<NarrativeDomainChronologyV1>({
+    timelines: keyedArray(objectV1({ timelineKey: keyV1, calendar: textV1, unit: keyV1, epoch: textV1 }), item => item.timelineKey),
+    mappings: keyedArray(objectV1({ mappingKey: keyV1, targetWorldGroup: source(['worldGroupId']),
+      fromTimelineKey: keyV1, toTimelineKey: keyV1, fromStart: integerTextV1, fromEnd: nullableV1(integerTextV1),
+      numerator: integerTextV1, denominator: integerTextV1, offset: integerTextV1, evidenceKeys: uniqueKeysV1 }), item => item.mappingKey),
+  })
+  const fields: { [K in keyof Required<NarrativeDomainFieldsV1>]: DecoderV1<NonNullable<NarrativeDomainFieldsV1[K]>> } = {
+    ...metadata, narrativeAliasesV1: uniqueKeysV1, narrativeEventV1: eventPayload,
+    narrativeAssertionV1: objectV1({ polarity: enumV1(['positive', 'negative'] as const) }),
+    narrativeRuleV1: objectV1({ preconditions: arrayV1(assertion) }),
+    narrativeRelationV1: objectV1({ causeEvent: nullableV1(event) }), narrativeEpistemicV1: epistemic,
+    narrativeDevelopmentsV1: keyedArray(development, item => item.semanticSubKey),
+    narrativeDisclosuresV1: keyedArray(disclosure, item => item.semanticSubKey), narrativeChronologyV1: chronology,
+  }
+  return { fields, source: anySource }
+}
+
+const local = decoders('local'), portable = decoders('portable')
+export type NarrativeDomainFieldV1 = keyof NarrativeDomainFieldsV1
+export const NARRATIVE_DOMAIN_FIELDS_V1 = Object.freeze(Object.keys(local.fields) as NarrativeDomainFieldV1[])
+
+/** Used by governed field adoption and the exact backup boundary. Permission,
+ * source existence, review receipts and publishability are checked separately. */
+export function parseNarrativeDomainFieldV1<K extends NarrativeDomainFieldV1>(
+  field: K, value: unknown, coordinate: 'local' | 'portable' = 'local',
+): NonNullable<NarrativeDomainFieldsV1[K]> {
+  canonicalNarrativeJsonV1(value)
+  const decoder = (coordinate === 'local' ? local : portable).fields[field]
+  if (!decoder) narrativeFail('domain-field', `未登记叙事字段 ${field}`)
+  return decoder(value, field) as NonNullable<NarrativeDomainFieldsV1[K]>
+}
+export function parseNarrativeDomainSourceRefV1(value: unknown, coordinate: 'local' | 'portable' = 'local'): NarrativeDomainSourceRefV1 {
+  canonicalNarrativeJsonV1(value)
+  return (coordinate === 'local' ? local : portable).source(value, 'source')
+}
+
+/** Only walk a field after exact decoding. No arbitrary JSON object can
+ * smuggle a ref-shaped leaf past the typed domain boundary. */
+export function mapNarrativeDomainReferencesV1<K extends NarrativeDomainFieldV1>(
+  field: K, value: unknown, map: (source: NarrativeDomainSourceRefV1) => NarrativeDomainSourceRefV1,
+  coordinate: 'local' | 'portable' = 'local',
+): NonNullable<NarrativeDomainFieldsV1[K]> {
+  const walk = (item: unknown): unknown => {
+    if (Array.isArray(item)) return item.map(walk)
+    if (!item || typeof item !== 'object') return item
+    const row = item as Record<string, unknown>
+    if (hasOwn(row, 'sourceUid')) return map(row as NarrativeDomainSourceRefV1)
+    return Object.fromEntries(Object.entries(row).map(([key, value]) => [key, walk(value)]))
+  }
+  return walk(parseNarrativeDomainFieldV1(field, value, coordinate)) as NonNullable<NarrativeDomainFieldsV1[K]>
+}
diff --git a/src/lib/narrative-domain/integrity.ts b/src/lib/narrative-domain/integrity.ts
new file mode 100644
index 00000000..95972033
--- /dev/null
+++ b/src/lib/narrative-domain/integrity.ts
@@ -0,0 +1,82 @@
+import { PROJECT_TABLES } from '../registry/project-tables'
+import type { TableSpec } from '../registry/types'
+import { mapNarrativeDomainReferencesV1, NARRATIVE_DOMAIN_FIELDS_V1 } from './codec'
+import { narrativeDomainReferenceTargetV1 } from './references'
+import { narrativeFail } from './json'
+
+type Row = Record<string, unknown>
+type Rows = ReadonlyMap<string, readonly Row[]>
+type IdentitySpec = Pick<TableSpec, 'name' | 'domainOwner' | 'resourceIdentity' | 'exportIdField' | 'exportRemap' | 'worldSemantic'>
+
+/** Validate identities against the same immutable capture used for export or
+ * import. Numeric coordinates never establish identity on their own. Missing
+ * local sources become tombstones on export; missing portable targets abort. */
+export function assertNarrativeDomainReferenceRowsV1(rows: Rows, coordinate: 'local' | 'portable', specs: readonly IdentitySpec[] = PROJECT_TABLES): void {
+  const byTable = new Map(specs.map(spec => [spec.name, spec]))
+  const byId = new Map<string, Map<number, Row>>()
+  const counts = new Map<string, Map<string, number>>()
+  for (const spec of specs) {
+    const ids = new Map<number, Row>(), uids = new Map<string, number>()
+    for (const [index, row] of (rows.get(spec.name) ?? []).entries()) {
+      const id = coordinate === 'local' ? row.id : spec.exportIdField ? row._exportId : index
+      if (typeof id === 'number') ids.set(id, row)
+      const uid = spec.resourceIdentity && row[spec.resourceIdentity.field]
+      if (typeof uid === 'string') uids.set(uid.toLowerCase(), (uids.get(uid.toLowerCase()) ?? 0) + 1)
+    }
+    byId.set(spec.name, ids); counts.set(spec.name, uids)
+  }
+  const fk = (spec: IdentitySpec, row: Row, field: string): unknown => coordinate === 'local' ? row[field]
+    : row[spec.exportRemap?.find(remap => remap.field === field)?.exportAs ?? field]
+  const owner = (spec: IdentitySpec, row: Row, seen = new Set<string>()): { world?: unknown; work?: unknown } => {
+    const locator = spec.domainOwner?.locator
+    if (!locator || locator.kind === 'workspace') return {}
+    const token = `${spec.name}:${coordinate === 'local' ? row.id : row._exportId}`
+    if (seen.has(token)) narrativeFail('owner-cycle', '叙事来源 owner 存在循环')
+    seen.add(token)
+    if (locator.kind === 'parent') {
+      const parent = byTable.get(locator.table)!
+      const record = byId.get(parent.name)?.get(fk(spec, row, locator.field) as number)
+      return record ? owner(parent, record, seen) : {}
+    }
+    const workField = locator.kind === 'field' && locator.owner === 'work' ? locator.field
+      : locator.kind === 'exclusive-fields' || locator.kind === 'exclusive-work-instance' ? locator.workField : null
+    const worldField = locator.kind === 'field' && locator.owner === 'world' ? locator.field
+      : locator.kind === 'exclusive-fields' ? locator.worldField : null
+    const work = coordinate === 'portable' ? row._workOwnerExportId ?? (workField ? fk(spec, row, workField) : undefined)
+      : workField ? row[workField] : undefined
+    const explicitWorld = coordinate === 'portable' ? row._worldOwnerExportId ?? (worldField ? fk(spec, row, worldField) : undefined)
+      : worldField ? row[worldField] : undefined
+    const workRow = typeof work === 'number' ? byId.get('works')?.get(work) : undefined
+    const world = explicitWorld ?? (workRow && (coordinate === 'local' ? workRow.worldId : workRow._worldExportId))
+    return { work, world }
+  }
+  for (const spec of specs) for (const row of rows.get(spec.name) ?? []) {
+    const allowed = spec.worldSemantic?.projector?.annotationFields ?? []
+    for (const field of NARRATIVE_DOMAIN_FIELDS_V1) {
+      const key = coordinate === 'local' ? field : `_${field}Portable`
+      if (!Object.prototype.hasOwnProperty.call(row, key)) continue
+      if (!allowed.includes(field)) narrativeFail('domain-field', `${spec.name}.${field} 未登记`)
+      mapNarrativeDomainReferencesV1(field, row[key], source => {
+        const target = narrativeDomainReferenceTargetV1(source)
+        if (target.id === null) return source
+        const record = byId.get(target.table)?.get(target.id)
+        if (!record) {
+          if (coordinate === 'portable') narrativeFail('source-missing', `${spec.name}.${field} 便携来源不存在`)
+          return source
+        }
+        const targetSpec = byTable.get(target.table)!
+        if (record[targetSpec.resourceIdentity!.field] !== target.sourceUid
+          || counts.get(target.table)?.get(target.sourceUid.toLowerCase()) !== 1) {
+          narrativeFail('reference-identity', `${spec.name}.${field} 的来源 UID 与编号不一致或不唯一`)
+        }
+        const from = owner(spec, row), to = owner(targetSpec, record)
+        if ((coordinate === 'local' && row.projectId !== record.projectId)
+          || from.world == null || to.world == null || from.world !== to.world
+          || (from.work != null && to.work != null && from.work !== to.work)) {
+          narrativeFail('scope', `${spec.name}.${field} 不允许跨 World/Work 引用`)
+        }
+        return source
+      }, coordinate)
+    }
+  }
+}
diff --git a/src/lib/narrative-domain/json.ts b/src/lib/narrative-domain/json.ts
new file mode 100644
index 00000000..f83ff52a
--- /dev/null
+++ b/src/lib/narrative-domain/json.ts
@@ -0,0 +1,242 @@
+import { sha256 } from '@noble/hashes/sha2.js'
+
+/** Separate from immutable v3 release canonicalization. Never change the v3 comparator. */
+export class NarrativeContractErrorV1 extends Error {
+  constructor(readonly code: string, message: string) {
+    super(`[narrative-ir:${code}] ${message}`)
+    this.name = 'NarrativeContractErrorV1'
+  }
+}
+export function narrativeFail(code: string, message: string): never {
+  throw new NarrativeContractErrorV1(code, message)
+}
+export function compareUnicodeCodePointsV1(a: string, b: string): number {
+  if (a === b) return 0
+  let left = 0, right = 0
+  while (left < a.length && right < b.length) {
+    const aPoint = a.codePointAt(left)!, bPoint = b.codePointAt(right)!
+    const difference = aPoint - bPoint
+    if (difference) return difference
+    left += aPoint > 0xffff ? 2 : 1
+    right += bPoint > 0xffff ? 2 : 1
+  }
+  // Only the sign matters to callers; code-point order is unchanged and no
+  // temporary arrays proportional to long semantic IDs are allocated.
+  return left < a.length ? 1 : right < b.length ? -1 : 0
+}
+export function assertUnicodeV1(text: string): void {
+  for (let index = 0; index < text.length; index++) {
+    const unit = text.charCodeAt(index)
+    if (unit >= 0xd800 && unit <= 0xdbff) {
+      const next = text.charCodeAt(++index)
+      if (!(next >= 0xdc00 && next <= 0xdfff)) narrativeFail('unicode', '孤立 surrogate 不可编码为原文证据')
+    } else if (unit >= 0xdc00 && unit <= 0xdfff) narrativeFail('unicode', '孤立 surrogate 不可编码为原文证据')
+  }
+}
+/** Exact raw UTF-8 length, without allocating a byte array. */
+export function narrativeUtf8ByteLengthV1(text: string): number {
+  let bytes = 0
+  for (let index = 0; index < text.length; index++) {
+    const unit = text.charCodeAt(index)
+    if (unit >= 0xd800 && unit <= 0xdbff) {
+      const next = text.charCodeAt(++index)
+      if (!(next >= 0xdc00 && next <= 0xdfff)) narrativeFail('unicode', '孤立 surrogate 不可编码为原文证据')
+      bytes += 4
+    } else if (unit >= 0xdc00 && unit <= 0xdfff) narrativeFail('unicode', '孤立 surrogate 不可编码为原文证据')
+    else bytes += unit < 0x80 ? 1 : unit < 0x800 ? 2 : 3
+  }
+  return bytes
+}
+/** Validation and encoding share one traversal. Validation alone must not
+ * allocate a second, potentially very large serialized artifact. */
+function walkNarrativeJsonV1(value: unknown, write?: (part: string) => void): void {
+  const stack = new Set<object>()
+  const visit = (item: unknown): void => {
+    if (item === null) { write?.('null'); return }
+    if (typeof item === 'string') { assertUnicodeV1(item); if (write) write(JSON.stringify(item)); return }
+    if (typeof item === 'boolean') { write?.(String(item)); return }
+    if (typeof item === 'number' && Number.isFinite(item) && !Object.is(item, -0)
+      && (!Number.isInteger(item) || Number.isSafeInteger(item))) { write?.(String(item)); return }
+    if (typeof item !== 'object' || !item) narrativeFail('json', '仅允许精确 JSON 值；禁止 undefined/非有限数/不安全整数')
+    if (stack.has(item)) narrativeFail('json-cycle', 'JSON 不允许循环对象')
+    stack.add(item)
+    if (Object.getOwnPropertySymbols(item).length) narrativeFail('json', '不允许 symbol 属性')
+    if (Array.isArray(item)) {
+      if (Object.keys(item).length !== item.length) narrativeFail('json', '数组必须稠密且无额外属性')
+      write?.('[')
+      for (let index = 0; index < item.length; index++) {
+        const descriptor = Object.getOwnPropertyDescriptor(item, index)
+        if (!descriptor || !('value' in descriptor)) narrativeFail('json', '数组必须稠密且不允许 accessor')
+        if (index) write?.(',')
+        visit(descriptor.value)
+      }
+      write?.(']')
+    } else {
+      if (Object.getPrototypeOf(item) !== Object.prototype && Object.getPrototypeOf(item) !== null) {
+        narrativeFail('json', '仅允许普通 JSON 对象')
+      }
+      const keys = Object.keys(item)
+      if (write) keys.sort(compareUnicodeCodePointsV1)
+      write?.('{')
+      for (let index = 0; index < keys.length; index++) {
+        const key = keys[index]
+        assertUnicodeV1(key)
+        const descriptor = Object.getOwnPropertyDescriptor(item, key)!
+        if (!('value' in descriptor)) narrativeFail('json', '不允许 accessor')
+        if (write) { if (index) write(','); write(`${JSON.stringify(key)}:`) }
+        visit(descriptor.value)
+      }
+      write?.('}')
+    }
+    stack.delete(item)
+  }
+  visit(value)
+}
+export function assertNarrativeJsonV1(value: unknown): void { walkNarrativeJsonV1(value) }
+export function canonicalNarrativeJsonV1(value: unknown): string {
+  return encodeNarrativeJsonV1(value)!
+}
+/** A disposable cache may stop encoding when its byte budget is exhausted.
+ * null is a refusal, never validation of the unvisited remainder. */
+export function boundedCanonicalNarrativeJsonV1(value: unknown, maxBytes: number): string | null {
+  if (!Number.isSafeInteger(maxBytes) || maxBytes < 0) narrativeFail('json-budget', 'JSON 字节预算必须是安全非负整数')
+  return encodeNarrativeJsonV1(value, maxBytes)
+}
+function encodeNarrativeJsonV1(value: unknown, maxBytes?: number): string | null {
+  // Bound the intermediate pieces instead of holding a serialized string for
+  // every nested subtree while serializing its ancestors. Wire bytes stay v1.
+  const chunks: string[] = []
+  let parts: string[] = [], length = 0, bytes = 0
+  const exhausted = Symbol('cache JSON budget exhausted')
+  try {
+    walkNarrativeJsonV1(value, part => {
+      if (maxBytes !== undefined) {
+        if (part.length > maxBytes - bytes || (bytes += narrativeUtf8ByteLengthV1(part)) > maxBytes) throw exhausted
+      }
+      parts.push(part); length += part.length
+      if (length >= 32_768) { chunks.push(parts.join('')); parts = []; length = 0 }
+    })
+  } catch (error) { if (error === exhausted) return null; throw error }
+  if (parts.length) chunks.push(parts.join(''))
+  return chunks.join('')
+}
+/** Exact canonical-value equality without allocating two complete encodings.
+ * Invalid JSON is still rejected, including accessors and cyclic objects. */
+export function equalNarrativeJsonV1(left: unknown, right: unknown): boolean {
+  assertNarrativeJsonV1(left); assertNarrativeJsonV1(right)
+  const equal = (a: unknown, b: unknown): boolean => {
+    if (a === b) return true
+    if (a === null || b === null || typeof a !== 'object' || typeof b !== 'object') return false
+    if (Array.isArray(a) !== Array.isArray(b)) return false
+    const aKeys = Object.keys(a), bKeys = Object.keys(b)
+    return aKeys.length === bKeys.length && aKeys.every(key => Object.prototype.hasOwnProperty.call(b, key)
+      && equal((a as Record<string, unknown>)[key], (b as Record<string, unknown>)[key]))
+  }
+  return equal(left, right)
+}
+const hashHex = (bytes: Uint8Array): string => Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('')
+/** SHA-256 is unchanged. Feed bounded UTF-8 pieces instead of allocating and
+ * transferring another complete encoding of a potentially large artifact.
+ * Updates consume each piece synchronously; caller mutation after the call
+ * cannot change a digest already being returned. */
+function incrementalNarrativeHash() {
+  const hash = sha256.create(), encoder = new TextEncoder()
+  const updateText = (text: string) => {
+    for (let start = 0; start < text.length;) {
+      let end = Math.min(start + 32_768, text.length)
+      const finalUnit = text.charCodeAt(end - 1)
+      if (end < text.length && finalUnit >= 0xd800 && finalUnit <= 0xdbff) end--
+      hash.update(encoder.encode(text.slice(start, end)))
+      start = end
+    }
+  }
+  return { updateText, updateBytes: (bytes: Uint8Array) => { hash.update(bytes) },
+    digest: () => hashHex(hash.digest()), destroy: () => hash.destroy() }
+}
+export async function hashNarrativeBytesV1(value: string | Uint8Array): Promise<string> {
+  if (typeof value === 'string') assertUnicodeV1(value)
+  const hash = incrementalNarrativeHash()
+  try {
+    if (typeof value === 'string') hash.updateText(value)
+    else hash.updateBytes(value)
+    return hash.digest()
+  } finally { hash.destroy() }
+}
+export const hashNarrativeValueV1 = (value: unknown): Promise<string> => {
+  const hash = incrementalNarrativeHash()
+  let parts: string[] = [], length = 0
+  const flush = () => { if (length) hash.updateText(parts.join('')); parts = []; length = 0 }
+  try {
+    // Use the same strict canonical traversal, including exact key order and
+    // invalid-JSON rejection. Only the sink changes, never the wire format.
+    walkNarrativeJsonV1(value, part => {
+      if (part.length >= 32_768) { flush(); hash.updateText(part) }
+      else { parts.push(part); length += part.length; if (length >= 32_768) flush() }
+    })
+    flush()
+    return Promise.resolve(hash.digest())
+  } finally { hash.destroy() }
+}
+
+export type DecoderV1<T> = (value: unknown, path: string) => T
+export const textV1: DecoderV1<string> = (value, path) => {
+  if (typeof value !== 'string') narrativeFail('shape', `${path} 必须是 string`)
+  assertUnicodeV1(value)
+  return value
+}
+export const keyV1: DecoderV1<string> = (value, path) => {
+  const text = textV1(value, path)
+  if (!text || text.trim() !== text) narrativeFail('shape', `${path} 必须是精确非空键`)
+  return text
+}
+export const hashV1: DecoderV1<string> = (value, path) => {
+  const text = textV1(value, path)
+  if (!/^[a-f0-9]{64}$/.test(text)) narrativeFail('hash', `${path} 必须是 SHA-256`)
+  return text
+}
+export const pointerV1: DecoderV1<string> = (value, path) => {
+  const pointer = textV1(value, path)
+  if (!/^(\/(?:[^~]|~[01])*)+$/.test(pointer)) narrativeFail('json-pointer', `${path} 必须是非空规范 JSON pointer`)
+  return pointer
+}
+export const uintV1: DecoderV1<number> = (value, path) => {
+  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 0 || Object.is(value, -0)) {
+    narrativeFail('shape', `${path} 必须是安全非负整数`)
+  }
+  return value
+}
+export const integerTextV1: DecoderV1<string> = (value, path) => {
+  const text = textV1(value, path)
+  if (!/^(0|-?[1-9][0-9]*)$/.test(text)) narrativeFail('tick', `${path} 必须是规范十进制整数`)
+  return text
+}
+export const nullableV1 = <T>(decoder: DecoderV1<T>): DecoderV1<T | null> => (value, path) => value === null ? null : decoder(value, path)
+export const enumV1 = <T extends string | number>(values: readonly T[]): DecoderV1<T> => (value, path) => {
+  if (!values.includes(value as T)) narrativeFail('enum', `${path} 不支持 ${String(value)}`)
+  return value as T
+}
+export const arrayV1 = <T>(decoder: DecoderV1<T>): DecoderV1<T[]> => (value, path) => {
+  if (!Array.isArray(value)) narrativeFail('shape', `${path} 必须是数组`)
+  return value.map((item, index) => decoder(item, `${path}[${index}]`))
+}
+export const uniqueKeysV1: DecoderV1<string[]> = (value, path) => {
+  const keys = arrayV1(keyV1)(value, path)
+  if (new Set(keys).size !== keys.length) narrativeFail('duplicate', `${path} 键重复`)
+  return keys.sort(compareUnicodeCodePointsV1)
+}
+export function objectV1<T extends object>(shape: { [K in keyof T]-?: DecoderV1<T[K]> }): DecoderV1<T> {
+  const expected = Object.keys(shape)
+  return (value, path) => {
+    if (!value || typeof value !== 'object' || Array.isArray(value)) narrativeFail('shape', `${path} 必须是对象`)
+    if (Object.keys(value).length !== expected.length || expected.some(key => !Object.prototype.hasOwnProperty.call(value, key))) {
+      narrativeFail('exact-keys', `${path} 缺少字段或含额外字段`)
+    }
+    const decoded: Record<string, unknown> = {}
+    for (const key of expected) {
+      const field = (shape[key as keyof T] as DecoderV1<unknown>)((value as Record<string, unknown>)[key], `${path}.${key}`)
+      if (key === '__proto__') Object.defineProperty(decoded, key, { value: field, writable: true, enumerable: true, configurable: true })
+      else decoded[key] = field
+    }
+    return decoded as T
+  }
+}
