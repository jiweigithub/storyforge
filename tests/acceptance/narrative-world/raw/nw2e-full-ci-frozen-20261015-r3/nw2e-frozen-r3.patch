+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { db } from '../../src/lib/db/schema'
+import { deleteWorld } from '../../src/lib/workspace/lifecycle'
+import { seedNarrativeRelationReleaseV4 } from '../helpers/narrative-release-fixture'
+import { createChatDraftV1, selectChatWorldV1, readChatDraftV1 } from '../../src/lib/character-interaction/draft-service'
+import { createAvgDraftV1, selectAvgWorldV1, readAvgDraftV1 } from '../../src/lib/avg/draft-service'
+import { readWorldNarrativeIndexV1, clearWorldNarrativeIndexMemoryV1 } from '../../src/lib/world-engine/narrative-index-cache'
+import { openProductPreparationWorldQueryV1, bindWorldQueryResourcesV1, describeWorldQueryAccessV1 } from '../../src/lib/context-gateway/world-query-client'
+import { verifyWorldReleaseRecordV1 } from '../../src/lib/world-engine/release-codec'
+
+describe('NW-2E · 删除隔离与事务退化（无作者数据）', () => {
+  beforeEach(async () => { clearWorldNarrativeIndexMemoryV1(); await db.delete(); await db.open() })
+  afterEach(() => { vi.restoreAllMocks(); clearWorldNarrativeIndexMemoryV1(); db.close() })
+
+  it('删除原世界须确认；两产品自己的冻结副本在原件删除和冷重开后仍可读', async () => {
+    const source = await seedNarrativeRelationReleaseV4({ explicitEntityEvidence: true })
+    const consumers = []
+    for (const type of ['character-interaction', 'avg'] as const) {
+      const product = type === 'avg' ? await createAvgDraftV1('删除隔离 AVG') : await createChatDraftV1('删除隔离聊天')
+      const draft = await (type === 'avg' ? readAvgDraftV1 : readChatDraftV1)(product.scope)
+      const selected = await (type === 'avg' ? selectAvgWorldV1 : selectChatWorldV1)(product.scope, draft.revision, source.release.id!)
+      const release = (await db.worldReleases.get(selected.worldReleaseId!))!
+      await readWorldNarrativeIndexV1({ ...product.scope, releaseId: release.id! })
+      consumers.push({ type, scope: product.scope, release })
+    }
+    const priorAccess = await openProductPreparationWorldQueryV1({ scope: source.scope,
+      localReleaseRecordId: source.release.id!, productType: 'avg' })
+    await expect(deleteWorld(source.scope.worldId)).rejects.toThrow('必须显式确认')
+    expect(await db.worldReleases.get(source.release.id!)).toEqual(source.release)
+    await deleteWorld(source.scope.worldId, { confirm: true })
+    expect(await db.worldReleases.where('worldId').equals(source.scope.worldId).count()).toBe(0)
+    expect(await db.worldNarrativeIndexCaches.where('worldId').equals(source.scope.worldId).count()).toBe(0)
+    await expect(describeWorldQueryAccessV1(priorAccess)).rejects.toThrow()
+    clearWorldNarrativeIndexMemoryV1(); db.close(); await db.open()
+    for (const consumer of consumers) {
+      expect(await db.worldReleases.get(consumer.release.id!)).toEqual(consumer.release)
+      const verified = await verifyWorldReleaseRecordV1(consumer.release)
+      expect(verified.version).toBe(4)
+      const access = await openProductPreparationWorldQueryV1({ scope: consumer.scope,
+        localReleaseRecordId: consumer.release.id!, productType: consumer.type })
+      const provider = await bindWorldQueryResourcesV1(access)
+      expect((await provider.listMetadata({ scope: access.scope, limit: 100 })).items).toHaveLength(3)
+    }
+  })
+
+  it('World 最后一步删除失败时，作品、原文、发布和缓存一并回滚，旧发布还能重建验证', async () => {
+    const source = await seedNarrativeRelationReleaseV4({ explicitEntityEvidence: true })
+    await readWorldNarrativeIndexV1({ ...source.scope, releaseId: source.release.id! })
+    const before = { world: await db.worlds.get(source.scope.worldId), work: await db.works.get(source.scope.workId),
+      characters: await db.characters.toArray(), releases: await db.worldReleases.toArray(), caches: await db.worldNarrativeIndexCaches.toArray() }
+    vi.spyOn(db.worlds, 'delete').mockRejectedValueOnce(Error('injected final World delete failure'))
+    await expect(deleteWorld(source.scope.worldId, { confirm: true })).rejects.toThrow('injected final World delete failure')
+    expect({ world: await db.worlds.get(source.scope.worldId), work: await db.works.get(source.scope.workId),
+      characters: await db.characters.toArray(), releases: await db.worldReleases.toArray(), caches: await db.worldNarrativeIndexCaches.toArray() }).toEqual(before)
+    clearWorldNarrativeIndexMemoryV1(); db.close(); await db.open()
+    expect((await readWorldNarrativeIndexV1({ ...source.scope, releaseId: source.release.id! })).verified.version).toBe(4)
+  })
+})
diff --git a/tests/regression/R-NW-2E-packing.test.ts b/tests/regression/R-NW-2E-packing.test.ts
new file mode 100644
index 00000000..99369ca3
--- /dev/null
+++ b/tests/regression/R-NW-2E-packing.test.ts
@@ -0,0 +1,88 @@
+import { describe, expect, it } from 'vitest'
+import { packNarrativeJsonV1, unpackNarrativeJsonV1, type PackedNarrativeJsonV1 } from '../../src/lib/world-engine/narrative-package-packing'
+import { canonicalNarrativeJsonV1 } from '../../src/lib/world-engine/narrative-json'
+import golden from '../acceptance/narrative-world/worldrelease-v4-content-golden.json'
+import { compressNarrativePackV1, decompressNarrativePackV1 } from '../../src/lib/world-engine/narrative-package-compression'
+import { gzipSync } from 'node:zlib'
+import { createHash } from 'node:crypto'
+
+describe('NW-2E · 独立版本的无损字典传输', () => {
+  it('固定 v4 原文和索引逐字往返，键序变化不影响打包内容', () => {
+    const original = { manifest: golden.compiled.manifest, index: golden.compiled.index }
+    const packed = packNarrativeJsonV1(original)
+    expect(canonicalNarrativeJsonV1(unpackNarrativeJsonV1(packed))).toBe(canonicalNarrativeJsonV1(original))
+    expect(packNarrativeJsonV1({ index: original.index, manifest: original.manifest })).toEqual(packed)
+    expect(canonicalNarrativeJsonV1(packed).length).toBeLessThan(canonicalNarrativeJsonV1(original).length)
+    expect(packNarrativeJsonV1(unpackNarrativeJsonV1(packed))).toEqual(packed)
+  })
+
+  it('保留空键、__proto__、数组顺序和补充平面 Unicode；不更改对象原型', () => {
+    const value = JSON.parse('{"__proto__":{"polluted":true},"":[],"𐀀":["é","é",null,false,1e-7,-3]}')
+    const decoded = unpackNarrativeJsonV1(packNarrativeJsonV1(value)) as Record<string, unknown>
+    expect(canonicalNarrativeJsonV1(decoded)).toBe(canonicalNarrativeJsonV1(value))
+    expect(Object.getPrototypeOf(decoded)).toBe(Object.prototype)
+    expect(Object.hasOwn(decoded, '__proto__')).toBe(true)
+    expect(Object.hasOwn({}, 'polluted')).toBe(false)
+  })
+
+  it.each(['extra', 'future', 'duplicate-string', 'unused-string', 'duplicate-shape', 'unused-shape',
+    'missing-field', 'shape-outside', 'string-outside', 'shape-order', 'string-order', 'literal-string'])(
+    '拒绝错误/非规范传输：%s', mutation => {
+      const packed: any = packNarrativeJsonV1({ a: 'one', b: ['two', 'one'] })
+      if (mutation === 'extra') packed.extra = true
+      if (mutation === 'future') packed.version = 2
+      if (mutation === 'duplicate-string') packed.strings.push(packed.strings[0])
+      if (mutation === 'unused-string') packed.strings.push('unused')
+      if (mutation === 'duplicate-shape') packed.shapes.push([...packed.shapes[0]])
+      if (mutation === 'unused-shape') packed.shapes.push([])
+      if (mutation === 'missing-field') packed.root.pop()
+      if (mutation === 'shape-outside') packed.root[0] = 999
+      if (mutation === 'string-outside') packed.root[1][1] = 999
+      if (mutation === 'shape-order') packed.shapes[0].reverse()
+      if (mutation === 'string-order') [packed.strings[2], packed.strings[3]] = [packed.strings[3], packed.strings[2]]
+      if (mutation === 'literal-string') packed.root[1] = 'unencoded'
+      // Reordering just string values can form another valid semantic packet;
+      // the enclosing frozen content hash must reject that change instead.
+      if (mutation === 'string-order') expect(unpackNarrativeJsonV1(packed)).not.toEqual({ a: 'one', b: ['two', 'one'] })
+      else expect(() => unpackNarrativeJsonV1(packed)).toThrow()
+    },
+  )
+
+  it('重复引用的展开预算在构造展开对象前核算，不能借小字典制造超限内容', () => {
+    const packed: PackedNarrativeJsonV1 = { schema: 'storyforge.narrative-json-pack', version: 1,
+      strings: ['桥'.repeat(1_000_000)], shapes: [], root: [1, ...Array.from({ length: 50 }, () => [0, 0] as [number, number])] }
+    expect(() => unpackNarrativeJsonV1(packed)).toThrow('128 MiB')
+    let root: PackedNarrativeJsonV1['root'] = null
+    for (let i = 0; i < 130; i++) root = [1, root]
+    expect(() => unpackNarrativeJsonV1({ ...packed, strings: [], root })).toThrow('深度')
+  })
+
+  it('标准压缩层逐字往返；同一实现重复生成相同传输，解压后仍须校验字典和内容', async () => {
+    const packed = packNarrativeJsonV1({ manifest: golden.compiled.manifest, index: golden.compiled.index })
+    const compressed = await compressNarrativePackV1(packed)
+    expect(await compressNarrativePackV1(packed)).toEqual(compressed)
+    expect(await decompressNarrativePackV1(compressed)).toEqual(packed)
+    for (const changed of [{ ...compressed, extra: true }, { ...compressed, encoding: 'deflate' },
+      { ...compressed, decodedBytes: compressed.decodedBytes - 1 }, { ...compressed, decodedBytes: compressed.decodedBytes + 1 },
+      { ...compressed, decodedHash: '0'.repeat(64) }, { ...compressed, data: compressed.data.slice(0, -4) },
+      { ...compressed, data: compressed.data + '\n' }, { ...compressed, decodedBytes: 64 * 1024 * 1024 + 1 }]) {
+      await expect(decompressNarrativePackV1(changed)).rejects.toThrow()
+    }
+  })
+
+  it('小压缩流不能绕过声明的展开限额', async () => {
+    const compressed = await compressNarrativePackV1(packNarrativeJsonV1('桥'.repeat(100_000)))
+    expect(compressed.data.length).toBeLessThan(2000)
+    await expect(decompressNarrativePackV1({ ...compressed, decodedBytes: 100 })).rejects.toThrow('展开超过')
+  })
+
+  it('兼容另一 gzip 实现，但不接受重签的 BOM 或非规范 JSON 字节', async () => {
+    const packed = packNarrativeJsonV1({ source: '桥' }), canonical = canonicalNarrativeJsonV1(packed)
+    const compressed = await compressNarrativePackV1(packed)
+    const wrap = (text: string) => { const bytes = Buffer.from(text); return { ...compressed,
+      decodedBytes: bytes.length, decodedHash: createHash('sha256').update(bytes).digest('hex'), data: gzipSync(bytes).toString('base64') } }
+    expect(await decompressNarrativePackV1(wrap(canonical))).toEqual(packed)
+    await expect(decompressNarrativePackV1(wrap('\ufeff' + canonical))).rejects.toThrow()
+    await expect(decompressNarrativePackV1(wrap(JSON.stringify(packed)))).rejects.toThrow('规范 JSON')
+  })
+})
diff --git a/tests/regression/R-NW-2E-scale.test.ts b/tests/regression/R-NW-2E-scale.test.ts
new file mode 100644
index 00000000..3ab31ef0
--- /dev/null
+++ b/tests/regression/R-NW-2E-scale.test.ts
@@ -0,0 +1,74 @@
+import { describe, expect, it } from 'vitest'
+import { writeFileSync } from 'node:fs'
+import { buildNarrativeScaleInputV1 } from '../helpers/narrative-scale-fixture'
+import { compileWorldReleaseContentV4 } from '../../src/lib/world-engine/narrative-release-v4'
+import { canonicalNarrativeJsonV1, hashNarrativeBytesV1 } from '../../src/lib/world-engine/narrative-json'
+import scalePlan from '../acceptance/narrative-world/scale-plan-20261015-v1.json'
+import { packNarrativeJsonV1 } from '../../src/lib/world-engine/narrative-package-packing'
+
+describe('NW-2E · 规模输入合同（CI 小样本不是性能验收）', () => {
+  it('真实注册 codec 编译具有不同场景和固定早/晚针事实的输入，原文字符量与去重统计可核对', async () => {
+    const fixture = await buildNarrativeScaleInputV1(1000)
+    expect(fixture.stats.unicodeCharacters).toBe(1000)
+    expect(fixture.stats.distinctTextCharacters).toBe(1000)
+    expect(fixture.stats.duplicateExactTextCharacters).toBe(0)
+    expect(fixture.stats.sourceFields).toBe(fixture.stats.declaredRecords)
+    for (const needle of fixture.needles) {
+      const row = fixture.input.records.historicalTimelineEvents.find(row => row.ragDocumentId === needle.sourceUid)!
+      expect(row.description).toContain(needle.quote)
+    }
+    const compiled = await compileWorldReleaseContentV4(fixture.input)
+    expect(compiled.manifest.narrative.bundle.records).toHaveLength(fixture.stats.declaredRecords)
+    expect(compiled.index.indexes.adjacency.length).toBeGreaterThanOrEqual(fixture.stats.declaredParticipantEdges)
+    expect(compiled.manifest.narrative.coverage.gaps).toEqual([])
+    expect(await compileWorldReleaseContentV4(fixture.input)).toEqual(compiled)
+  }, 30_000)
+
+  it.runIf(process.env.NW_SCALE_DIAGNOSTIC === '1')('首次三规模诊断保存实际失败和耗时，不能替代五次冷/三十次热浏览器证据', async () => {
+    const results: unknown[] = []
+    const output = process.env.NW_SCALE_DIAGNOSTIC_REPORT
+    if (!output) throw Error('A new NW_SCALE_DIAGNOSTIC_REPORT destination is required')
+    const generatedAt = new Date().toISOString()
+    try {
+      const sizes = process.env.NW_SCALE_DIAGNOSTIC_SIZES?.split(',').map(Number) ?? scalePlan.sourceUnicodeCharacters
+      if (sizes.some(size => !scalePlan.sourceUnicodeCharacters.includes(size))) throw Error('Only frozen plan sizes may be measured')
+      for (const size of sizes) {
+        const generationStart = performance.now(), fixture = await buildNarrativeScaleInputV1(size)
+        const generationMs = performance.now() - generationStart
+        const inputHash = await hashNarrativeBytesV1(canonicalNarrativeJsonV1(fixture.input))
+        const profilePath = process.env.NW_SCALE_CPU_PROFILE
+        const profiler = profilePath ? new (await import('node:inspector/promises')).Session() : null
+        if (profiler) { profiler.connect(); await profiler.post('Profiler.enable'); await profiler.post('Profiler.start') }
+        const start = performance.now()
+        try {
+          const compiled = await compileWorldReleaseContentV4(fixture.input)
+          const compileMs = performance.now() - start
+          const bytes = (value: unknown) => new TextEncoder().encode(JSON.stringify(value)).length
+          const fieldBytes = (value: object) => Object.fromEntries(Object.entries(value).map(([key, item]) => [key, bytes(item)]))
+          const packed = packNarrativeJsonV1({ manifest: compiled.manifest, index: compiled.index })
+          results.push({ size, stats: fixture.stats, inputHash, generationMs, compileMs,
+            contentHash: compiled.contentHash, indexHash: compiled.index.indexHash,
+            records: compiled.manifest.narrative.bundle.records.length, edges: compiled.index.indexes.adjacency.length,
+            componentFieldBytes: { manifest: fieldBytes(compiled.manifest), projection: fieldBytes(compiled.manifest.narrative),
+              bundle: fieldBytes(compiled.manifest.narrative.bundle), indexes: fieldBytes(compiled.index.indexes) },
+            packedTransport: { bytes: bytes(packed), strings: packed.strings.length, shapes: packed.shapes.length,
+              stringTableBytes: bytes(packed.strings), shapeTableBytes: bytes(packed.shapes), rootBytes: bytes(packed.root) },
+            compiledComponentBytes: new TextEncoder().encode(canonicalNarrativeJsonV1({ manifest: compiled.manifest, index: compiled.index })).length })
+        } catch (error) {
+          results.push({ size, stats: fixture.stats, inputHash, generationMs, compileMs: performance.now() - start, error: error instanceof Error ? error.message : String(error) })
+        } finally {
+          if (profiler) {
+            const { profile } = await profiler.post('Profiler.stop')
+            writeFileSync(`${profilePath}-${size}.cpuprofile`, JSON.stringify(profile), { flag: 'wx' })
+            profiler.disconnect()
+          }
+        }
+      }
+    } finally {
+      writeFileSync(output, JSON.stringify({ schema: 'storyforge.narrative-scale-diagnostic', version: 1, generatedAt,
+        plan: 'scale-plan-20261015-v1.json', evidenceLevel: 'single Node diagnostic; not browser performance acceptance',
+        node: process.version, cpuProfilingEnabled: !!process.env.NW_SCALE_CPU_PROFILE,
+        modelCalls: 0, independentHumanReviews: 0, results }, null, 2) + '\n', { flag: 'wx' })
+    }
+  }, 1_200_000)
+})
