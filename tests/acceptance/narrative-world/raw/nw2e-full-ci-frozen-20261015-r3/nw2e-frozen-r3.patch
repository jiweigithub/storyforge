index 00000000..531a05dd
--- /dev/null
+++ b/src/lib/world-engine/narrative-package-packing.ts
@@ -0,0 +1,129 @@
+import { assertNarrativeJsonV1, compareUnicodeCodePointsV1, narrativeFail } from './narrative-json'
+
+/** Transport only. These coordinates never become semantic or database IDs.
+ * null/boolean/number retain their JSON values. Tuples encode a string [0,id],
+ * array [1,...items], or object [shapeId+2,...fieldValues]. */
+export type PackedNarrativeValueV1 = null | boolean | number | [number, ...PackedNarrativeValueV1[]]
+export interface PackedNarrativeJsonV1 {
+  schema: 'storyforge.narrative-json-pack'
+  version: 1
+  strings: string[]
+  shapes: number[][]
+  root: PackedNarrativeValueV1
+}
+export const NARRATIVE_PACK_LIMITS_V1 = Object.freeze({ maxExpandedBytes: 128 * 1024 * 1024,
+  maxDepth: 128, maxNodes: 8_000_000, maxStrings: 1_000_000, maxShapes: 65_536 })
+const fail = (message: string): never => narrativeFail('package-packing', message)
+const scalarIndex = (value: unknown, length: number): value is number => Number.isSafeInteger(value)
+  && !Object.is(value, -0) && (value as number) >= 0 && (value as number) < length
+const stringBytes = (value: string): number => new TextEncoder().encode(JSON.stringify(value)).length
+
+export function packNarrativeJsonV1(value: unknown): PackedNarrativeJsonV1 {
+  assertNarrativeJsonV1(value)
+  const strings: string[] = [], shapes: number[][] = []
+  const stringIds = new Map<string, number>(), shapeIds = new Map<string, number>()
+  let nodes = 0, expanded = 0
+  const addBytes = (bytes: number) => {
+    expanded += bytes
+    if (expanded > NARRATIVE_PACK_LIMITS_V1.maxExpandedBytes) fail('展开内容超过 128 MiB')
+  }
+  const intern = (text: string) => {
+    const prior = stringIds.get(text)
+    if (prior !== undefined) return prior
+    if (strings.length >= NARRATIVE_PACK_LIMITS_V1.maxStrings) fail('字符串字典超限')
+    const id = strings.length; strings.push(text); stringIds.set(text, id); return id
+  }
+  const encode = (item: unknown, depth: number): PackedNarrativeValueV1 => {
+    if (depth > NARRATIVE_PACK_LIMITS_V1.maxDepth || ++nodes > NARRATIVE_PACK_LIMITS_V1.maxNodes) fail('树深度或节点预算超限')
+    if (typeof item === 'string') { addBytes(stringBytes(item)); return [0, intern(item)] }
+    if (item === null || typeof item === 'boolean' || typeof item === 'number') { addBytes(String(item).length); return item }
+    if (Array.isArray(item)) {
+      addBytes(2 + Math.max(0, item.length - 1))
+      return [1, ...item.map(child => encode(child, depth + 1))]
+    }
+    const object = item as Record<string, unknown>, keys = Object.keys(object).sort(compareUnicodeCodePointsV1)
+    addBytes(2 + Math.max(0, keys.length - 1) + keys.reduce((sum, key) => sum + stringBytes(key) + 1, 0))
+    const ids = keys.map(intern), identity = ids.join(',')
+    let shape = shapeIds.get(identity)
+    if (shape === undefined) {
+      if (shapes.length >= NARRATIVE_PACK_LIMITS_V1.maxShapes) fail('对象形状字典超限')
+      shape = shapes.length; shapes.push(ids); shapeIds.set(identity, shape)
+    }
+    return [shape + 2, ...keys.map(key => encode(object[key], depth + 1))]
+  }
+  const root = encode(value, 0)
+  return { schema: 'storyforge.narrative-json-pack', version: 1, strings, shapes, root }
+}
+
+/** A complete budget/reference/canonical-order pass runs before creating any
+ * expanded objects. Repeated string references cannot bypass expansion bounds. */
+export function unpackNarrativeJsonV1(input: unknown): unknown {
+  assertNarrativeJsonV1(input)
+  if (!input || typeof input !== 'object' || Array.isArray(input)) fail('缺少打包对象')
+  const value = input as PackedNarrativeJsonV1
+  const keys = Object.keys(value)
+  if (keys.length !== 5 || ['schema', 'version', 'strings', 'shapes', 'root'].some(key => !keys.includes(key))
+    || value.schema !== 'storyforge.narrative-json-pack' || value.version !== 1) fail('打包版本或字段不受支持')
+  if (!Array.isArray(value.strings) || value.strings.length > NARRATIVE_PACK_LIMITS_V1.maxStrings
+    || value.strings.some(text => typeof text !== 'string') || new Set(value.strings).size !== value.strings.length) fail('字符串字典重复、非法或超限')
+  if (!Array.isArray(value.shapes) || value.shapes.length > NARRATIVE_PACK_LIMITS_V1.maxShapes) fail('对象形状字典非法或超限')
+  const shapeKeys = new Set<string>()
+  for (const shape of value.shapes) {
+    if (!Array.isArray(shape) || shape.some(id => !scalarIndex(id, value.strings.length))) fail('对象字段引用越界')
+    if (shape.some((id, index) => index > 0 && compareUnicodeCodePointsV1(value.strings[shape[index - 1]], value.strings[id]) >= 0)) fail('对象字段重复或非规范顺序')
+    const key = shape.join(','); if (shapeKeys.has(key)) fail('对象形状重复'); shapeKeys.add(key)
+  }
+  const byteLengths = value.strings.map(stringBytes)
+  const usedStrings = new Set<number>(), usedShapes = new Set<number>()
+  const checkStringReference = (id: unknown): number => {
+    if (!scalarIndex(id, value.strings.length)) fail('字符串引用越界')
+    const index = id as number
+    if (!usedStrings.has(index)) {
+      if (index !== usedStrings.size) fail('字符串字典不是首次出现顺序')
+      usedStrings.add(index)
+    }
+    return index
+  }
+  let nodes = 0, expanded = 0
+  const addBytes = (bytes: number) => {
+    expanded += bytes
+    if (expanded > NARRATIVE_PACK_LIMITS_V1.maxExpandedBytes) fail('展开内容超过 128 MiB')
+  }
+  const inspect = (item: PackedNarrativeValueV1, depth: number): void => {
+    if (depth > NARRATIVE_PACK_LIMITS_V1.maxDepth || ++nodes > NARRATIVE_PACK_LIMITS_V1.maxNodes) fail('树深度或节点预算超限')
+    if (item === null || typeof item === 'number' || typeof item === 'boolean') { addBytes(String(item).length); return }
+    if (!Array.isArray(item) || !item.length || !Number.isSafeInteger(item[0]) || Object.is(item[0], -0) || item[0] < 0) fail('打包值不是合法标签元组')
+    if (item[0] === 0) {
+      if (item.length !== 2) fail('字符串元组字段不完整')
+      addBytes(byteLengths[checkStringReference(item[1])]); return
+    }
+    if (item[0] === 1) {
+      addBytes(2 + Math.max(0, item.length - 2))
+    } else {
+      const shapeId = item[0] - 2
+      if (!scalarIndex(shapeId, value.shapes.length)) fail('对象形状引用越界')
+      if (!usedShapes.has(shapeId)) {
+        if (shapeId !== usedShapes.size) fail('对象形状不是首次出现顺序')
+        usedShapes.add(shapeId)
+      }
+      const shape = value.shapes[shapeId]
+      if (item.length !== shape.length + 1) fail('对象字段和值数量不符')
+      addBytes(2 + Math.max(0, shape.length - 1))
+      for (const id of shape) addBytes(byteLengths[checkStringReference(id)] + 1)
+    }
+    for (let index = 1; index < item.length; index++) inspect(item[index], depth + 1)
+  }
+  inspect(value.root, 0)
+  if (usedStrings.size !== value.strings.length || usedShapes.size !== value.shapes.length) fail('字典含未使用项')
+  const decode = (item: PackedNarrativeValueV1): unknown => {
+    if (!Array.isArray(item)) return item
+    if (item[0] === 0) return value.strings[item[1] as number]
+    if (item[0] === 1) return item.slice(1).map(decode)
+    const result: Record<string, unknown> = {}
+    value.shapes[item[0] - 2].forEach((id, index) => Object.defineProperty(result, value.strings[id], {
+      value: decode(item[index + 1]), enumerable: true, writable: true, configurable: true,
+    }))
+    return result
+  }
+  return decode(value.root)
+}
diff --git a/src/lib/world-engine/narrative-release-capture.ts b/src/lib/world-engine/narrative-release-capture.ts
new file mode 100644
index 00000000..cfcae4e8
--- /dev/null
+++ b/src/lib/world-engine/narrative-release-capture.ts
@@ -0,0 +1,58 @@
+import Dexie from 'dexie'
+import { db } from '../db/schema'
+import type { WorkspaceScope } from '../types/world-ownership'
+import type { WorldReleaseSemanticContentV4 } from '../types/narrative-release'
+import { captureNarrativeDomainInTransactionV1, narrativeDomainCaptureTablesV1 } from './narrative-domain-capture'
+import { isShareableWorld } from './world-identity'
+import { canonicalNarrativeJsonV1, narrativeFail } from './narrative-json'
+import { deriveNarrativeSemanticTransferV1 } from './narrative-semantic-transfer'
+import { parseNarrativeLineageV1 } from './narrative-lineage'
+
+export type WorldReleaseInputV4 = Omit<WorldReleaseSemanticContentV4, 'narrative'>
+
+export function narrativeReleaseCaptureTablesV4() { return [...narrativeDomainCaptureTablesV1(), db.worldDerivations] }
+
+/** Semantic-only capture. Product/media state is never read into the snapshot.
+ * Reused inside the final write transaction for a source compare-and-swap. */
+export function captureWorldReleaseInputInTransactionV4(input: {
+  scope: WorkspaceScope; selectedTables?: readonly string[]; includeWorkSources?: boolean
+}): Promise<WorldReleaseInputV4> {
+  return Dexie.Promise.all([
+    db.projects.get(input.scope.projectId), db.worlds.get(input.scope.worldId), db.works.get(input.scope.workId),
+    db.worldDerivations.where('worldId').equals(input.scope.worldId).toArray(),
+  ]).then(([project, world, work, derivations]) => {
+    if (!project || !world || !work || world.projectId !== project.id || work.projectId !== project.id || work.worldId !== world.id
+      || project.workspacePurpose !== 'world-engine' || !isShareableWorld(world)) {
+      narrativeFail('release-owner', 'v4 封存必须明确选择世界引擎草稿；独立作品须先显式派生')
+    }
+    const lineages = derivations.filter(row => row.narrativeLineageJson !== undefined)
+    if (lineages.length > 1 || lineages.some(row => row.projectId !== project.id)) narrativeFail('release-lineage', '世界派生来源不唯一或不属于当前工作区')
+    const lineage = lineages[0] && parseNarrativeLineageV1(JSON.parse(lineages[0].narrativeLineageJson!))
+    if (lineage && (lineage.targetWorldCode !== world.code || lineage.sourceContentHash !== lineages[0].sourceContentHash)) narrativeFail('release-lineage', '派生回执与世界来源不匹配')
+    if (input.includeWorkSources !== undefined && typeof input.includeWorkSources !== 'boolean') narrativeFail('release-lineage', '作品来源选择必须明确')
+    const sourceWorkCode = input.includeWorkSources ? work.code : lineage?.sourceOwner.kind === 'work' ? lineage.sourceOwner.workCode : null
+    return Dexie.Promise.resolve(captureNarrativeDomainInTransactionV1({ scope: input.scope,
+      owner: { kind: 'world', worldCode: world.code, sourceWorkCode: input.includeWorkSources ? work.code : null } })).then(captured => {
+      const { transfer } = deriveNarrativeSemanticTransferV1({ capture: captured, project, world, work, selectedTables: input.selectedTables })
+      // Fixed neutral roots support import without transporting a product workflow.
+      // The source Work is a local locator, never the owner of frozen world records.
+      return {
+        schema: 'storyforge.world-release', version: 4, semanticContract: 4,
+        registryVersion: 'world-semantic-v4', compilerVersion: 'narrative-domain-v1',
+        worldCode: world.code, worldName: world.name, ...transfer,
+        sourceManifest: { sourceKind: 'world-draft', sourceWorkspaceUid: project.workspaceUid,
+          sourceWorldCode: world.code, sourceWorkCode, ...(lineage ? { lineage } : {}) },
+      } satisfies WorldReleaseInputV4
+    })
+  })
+}
+
+export async function captureWorldReleaseInputV4(input: {
+  scope: WorkspaceScope; selectedTables?: readonly string[]; includeWorkSources?: boolean
+}): Promise<{ input: WorldReleaseInputV4; inputJson: string }> {
+  const request = { scope: { ...input.scope }, selectedTables: input.selectedTables && [...input.selectedTables], includeWorkSources: input.includeWorkSources }
+  const captured = await db.transaction('r', narrativeReleaseCaptureTablesV4(), async () =>
+    await Dexie.Promise.resolve(captureWorldReleaseInputInTransactionV4(request)))
+  const inputJson = canonicalNarrativeJsonV1(captured)
+  return { input: JSON.parse(inputJson) as WorldReleaseInputV4, inputJson }
+}
diff --git a/src/lib/world-engine/narrative-release-v4.ts b/src/lib/world-engine/narrative-release-v4.ts
new file mode 100644
index 00000000..3dac8cb8
--- /dev/null
+++ b/src/lib/world-engine/narrative-release-v4.ts
@@ -0,0 +1,287 @@
+import type { WorldReleaseCompiledV4, WorldReleaseManifestV4, WorldReleaseSemanticContentV4 } from '../types/narrative-release'
+import type { WorldSemanticSnapshotV1 } from '../types/world-release'
+import type { NarrativeDomainCaptureV1, NarrativeDomainRowV1 } from './narrative-domain-capture'
+import type { NarrativeIndexV1 } from '../types/narrative-index'
+import { NARRATIVE_INDEX_RECIPE_V1 } from '../types/narrative-index'
+import { WORLD_SEMANTIC_REGISTRY_V4 } from './semantic-registry-v4'
+import { projectNarrativeDomainCaptureV1 } from './narrative-domain-projection'
+import { compileNarrativeIndexV1, verifyNarrativeIndexV1 } from './narrative-index'
+import { assertWorldSemanticSnapshotV1 } from './semantic-snapshot'
+import { remapNarrativeDomainFieldV1 } from '../narrative-domain/references'
+import { NARRATIVE_DOMAIN_FIELDS_V1 } from '../narrative-domain/codec'
+import { assertNarrativeDomainReferenceRowsV1 } from '../narrative-domain/integrity'
+import { parseWorldPortals } from '../utils/world-portals'
+import { isPortableResourceUidV1 } from '../context-gateway/resource-uid'
+import { isPublicWorldCode } from '../workspace/identity'
+import { isWorkspaceUid, isWorkCode } from '../memory/identity'
+import { attachNarrativeLineageV1, verifyNarrativeLineageV1 } from './narrative-lineage'
+import { assertNarrativeJsonV1, canonicalNarrativeJsonV1, equalNarrativeJsonV1, compareUnicodeCodePointsV1, hashNarrativeBytesV1, hashNarrativeValueV1, hashV1, narrativeFail,
+  keyV1, objectV1, enumV1, uniqueKeysV1 } from './narrative-json'
+
+/** v4 publishPolicy includes legitimate prior facts. The historical v3 status
+ * filter is deliberately not reused or widened. Unconfirmed proposals stay out. */
+export function isWorldReleaseSourceEligibleV4(table: string, row: Record<string, unknown>): boolean {
+  const policy = WORLD_SEMANTIC_REGISTRY_V4.tables.find(spec => spec.name === table)?.worldSemantic
+  if (!policy) return false
+  if (policy.canonPolicy === 'authoritative-table') return true
+  const status = String(row[policy.statusField!])
+  return Boolean(policy.confirmedStatusValues?.includes(status)
+    || (policy.publishPolicy === 'reviewed-narrative-v1' && table === 'temporalFacts' && status === 'superseded'))
+}
+
+const CONTENT_KEYS = ['schema', 'version', 'semanticContract', 'registryVersion', 'compilerVersion', 'worldCode',
+  'worldName', 'selectedTables', 'records', 'semanticSnapshot', 'sourceManifest', 'narrative'] as const
+
+function object(value: unknown, label: string): Record<string, unknown> {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) narrativeFail('release-shape', `${label} 必须是对象`)
+  return value as Record<string, unknown>
+}
+function exact(value: Record<string, unknown>, keys: readonly string[], label: string): void {
+  if (Object.keys(value).length !== keys.length || keys.some(key => !Object.prototype.hasOwnProperty.call(value, key))) {
+    narrativeFail('release-exact-keys', `${label} 缺字段或包含未知字段`)
+  }
+}
+function parse(value: string | unknown): Record<string, unknown> {
+  const bytes = typeof value === 'string' ? value : null
+  if (typeof value === 'string') {
+    try { value = JSON.parse(value) } catch { narrativeFail('release-json', '世界封存内容不是合法 JSON') }
+  }
+  if (bytes !== null) {
+    if (bytes !== canonicalNarrativeJsonV1(value)) narrativeFail('release-noncanonical', 'v4 冻结字节必须使用该版本的规范编码')
+    return object(value, 'manifest')
+  }
+  assertNarrativeJsonV1(value)
+  return object(structuredClone(value), 'manifest')
+}
+function contentOf(manifest: WorldReleaseManifestV4): WorldReleaseSemanticContentV4 {
+  const { semanticRootHash: _root, indexDescriptor: _index, ...content } = manifest
+  return content
+}
+
+/** Read-only decoding of portable coordinates for the versioned projector.
+ * This is not a database import and never allocates or writes author IDs. */
+export function captureFrozenNarrativeSourcesV4(input: {
+  worldCode: string
+  records: Record<string, Record<string, unknown>[]>
+  selectedTables: readonly string[]
+  semanticSnapshot: WorldSemanticSnapshotV1
+  sourceWorkCode?: string | null
+}): NarrativeDomainCaptureV1 {
+  if (!isPublicWorldCode(input.worldCode)) narrativeFail('release-world', 'v4 必须绑定可分享的 World 身份')
+  assertWorldSemanticSnapshotV1(input.semanticSnapshot)
+  const roots = input.semanticSnapshot
+  const sourceWorkCode = input.sourceWorkCode ?? null
+  if (roots.ownership.worldExportId !== 0 || roots.ownership.workExportId !== 0
+    || roots.worlds[0].code !== input.worldCode || roots.worlds[0].identityKind !== 'world-draft'
+    || !isWorkCode(roots.works[0].code) || !isWorkspaceUid(roots.project.workspaceUid)
+    || roots.project.workspacePurpose !== 'world-engine' || roots.works[0]._worldExportId !== 0) {
+    narrativeFail('release-roots', 'v4 语义根身份、用途或所有权不一致')
+  }
+  if (sourceWorkCode !== null && (!isWorkCode(sourceWorkCode) || sourceWorkCode !== roots.works[0].code)) {
+    narrativeFail('release-lineage', '明确选择的 Work 来源必须与冻结根身份一致')
+  }
+  const selected = uniqueKeysV1([...input.selectedTables], 'selectedTables')
+  const registry = WORLD_SEMANTIC_REGISTRY_V4
+  if (canonicalNarrativeJsonV1(selected) !== canonicalNarrativeJsonV1(input.selectedTables)
+    || selected.some(table => !registry.tables.some(spec => spec.name === table))
+    || canonicalNarrativeJsonV1(Object.keys(input.records).sort(compareUnicodeCodePointsV1)) !== canonicalNarrativeJsonV1(selected)) {
+    narrativeFail('release-selection', '所选领域必须与 v4 注册合同及原始来源精确闭合')
+  }
+  const maps = new Map<string, Map<number, number>>([
+    ['worlds', new Map([[0, 1]])], ['works', new Map([[0, 1]])],
+  ])
+  const rows = new Map<string, NarrativeDomainRowV1[]>()
+  for (const spec of registry.tables) {
+    const source = input.records[spec.name] ?? []
+    if (!Array.isArray(source)) narrativeFail('release-records', `${spec.name} 原始来源不是数组`)
+    const ids = new Map<number, number>(), uids = new Set<string>()
+    let prior = ''
+    for (const [index, raw] of source.entries()) {
+      const row = object(raw, spec.name), identity = spec.resourceIdentity!
+      const uid = row[identity.field]
+      if (!isPortableResourceUidV1(uid, identity.resourceKind) || uids.has(uid.toLowerCase())
+        || (index > 0 && compareUnicodeCodePointsV1(prior, uid) >= 0)
+        || (spec.exportIdField && row._exportId !== index)
+        || (!spec.exportIdField && '_exportId' in row)
+        || ['id', 'projectId', 'worldId', 'workId', '_instanceOwnerExportId'].some(field => field in row)) narrativeFail('release-source-identity', `${spec.name} 来源身份、排序或 owner 非法`)
+      const locator = spec.domainOwner!.locator
+      const worldOwned = row._worldOwnerExportId === 0 && !('_workOwnerExportId' in row)
+      const workOwned = row._workOwnerExportId === 0 && !('_worldOwnerExportId' in row)
+      if ((!worldOwned && !workOwned) || (workOwned && sourceWorkCode === null)
+        || (locator.kind === 'field' && (locator.owner === 'world' ? !worldOwned : locator.owner !== 'work' || !workOwned))
+        || !['field', 'exclusive-fields'].includes(locator.kind)) {
+        narrativeFail('release-owner', 'Work 来源必须明确选择并绑定来源身份；不能跨 owner 混入世界包')
+      }
+      const policy = spec.worldSemantic!
+      if (!isWorldReleaseSourceEligibleV4(spec.name, row)) {
+        narrativeFail('release-authority', '候选来源不能进入已封存 Canon')
+      }
+      for (const field of NARRATIVE_DOMAIN_FIELDS_V1) {
+        if (field in row || (`_${field}Portable` in row && !policy.projector?.annotationFields.includes(field))) {
+          narrativeFail('release-annotation', `${spec.name}.${field} 不是该版本登记的便携注释`)
+        }
+      }
+      ids.set(index, index + 1); uids.add(uid.toLowerCase()); prior = uid
+    }
+    maps.set(spec.name, ids)
+  }
+  assertNarrativeDomainReferenceRowsV1(new Map([...Object.entries(input.records), ['worlds', roots.worlds], ['works', roots.works]]),
+    'portable', [...registry.tables, { name: 'worlds', exportIdField: true }, { name: 'works', exportIdField: true }])
+  const mappedArray = (value: unknown, table: string): number[] => {
+    if (!Array.isArray(value) || value.some(id => !Number.isSafeInteger(id) || !maps.get(table)?.has(id))) {
+      narrativeFail('release-reference', '嵌套便携引用缺失或越界')
+    }
+    return value.map(id => maps.get(table)!.get(id)!)
+  }
+  for (const spec of registry.tables) {
+    rows.set(spec.name, (input.records[spec.name] ?? []).map((raw, index) => {
+      const row = { ...raw, id: index + 1, projectId: 1 } as NarrativeDomainRowV1
+      delete row._exportId
+      delete row._worldOwnerExportId
+      delete row._workOwnerExportId
+      const locator = spec.domainOwner!.locator
+      if (locator.kind === 'field') row[locator.field] = 1
+      else if (locator.kind === 'exclusive-fields') {
+        row[locator.worldField] = raw._worldOwnerExportId === 0 ? 1 : null
+        row[locator.workField] = raw._workOwnerExportId === 0 ? 1 : null
+      }
+      for (const ref of spec.exportRemap ?? []) {
+        if (ref.field in raw || !(ref.exportAs in raw)) narrativeFail('release-reference', `${spec.name}.${ref.field} 缺少规范便携引用`)
+        const portable = raw[ref.exportAs]
+        if (portable === null && (ref.onUnmapped === 'require' || ref.onUnmapped === 'drop')) narrativeFail('release-reference', `${spec.name}.${ref.field} 必填引用缺失`)
+        if (portable !== null && (!Number.isSafeInteger(portable) || !maps.get(ref.selfTree ? spec.name : ref.remapVia)?.has(portable as number))) {
+          narrativeFail('release-reference', `${spec.name}.${ref.field} 引用缺失或越界`)
+        }
+        row[ref.field] = portable === null ? null : maps.get(ref.selfTree ? spec.name : ref.remapVia)!.get(portable as number)!
+        delete row[ref.exportAs]
+      }
+      for (const ref of spec.exportRefRemap ?? []) {
+        if (ref.kind === 'narrative-source-refs-v1') {
+          if (!(ref.exportAs in raw)) continue
+          row[ref.field] = remapNarrativeDomainFieldV1(ref.field, raw[ref.exportAs], 'import', maps) as never
+          delete row[ref.exportAs]
+        } else if (ref.kind === 'id-array') {
+          if (ref.field in raw) narrativeFail('release-reference', '原始本地 ID 数组不能混入便携内容')
+          const restored = mappedArray(raw[ref.exportAs], ref.remapVia)
+          row[ref.field] = ref.storage === 'json-string' ? JSON.stringify(restored) : restored
+          delete row[ref.exportAs]
+        } else if (ref.kind === 'scene-character-ids') {
+          const scenes = raw[ref.field], shadows = raw[ref.exportAs]
+          if (!Array.isArray(scenes) || !Array.isArray(shadows) || shadows.length !== scenes.length) narrativeFail('release-reference', '场景与角色引用数组不闭合')
+          row[ref.field] = scenes.map((scene, position) => {
+            const original = object(scene, 'scene')
+            if (!Array.isArray(original.characterIds) || original.characterIds.length) narrativeFail('release-reference', '场景不能保留本地角色编号')
+            return { ...original, characterIds: mappedArray(shadows[position], ref.remapVia) }
+          })
+          delete row[ref.exportAs]
+        } else if (ref.kind === 'portals' && ref.field in raw) {
+          if (typeof raw[ref.field] !== 'string') narrativeFail('release-reference', '通道必须是规范便携 JSON')
+          let originals: unknown
+          try { originals = JSON.parse(raw[ref.field] as string) } catch { narrativeFail('release-reference', '通道不是合法 JSON') }
+          const portals = parseWorldPortals(raw[ref.field] as string)
+          if (!Array.isArray(originals) || originals.length !== portals.length) narrativeFail('release-reference', '通道原文含非法引用')
+          const ids = mappedArray(portals.map(portal => portal.targetWorldId), ref.remapVia)
+          row[ref.field] = JSON.stringify(portals.map((portal, position) => ({ ...portal, targetWorldId: ids[position] })))
+        }
+      }
+      return row
+    }))
+  }
+  const peers = new Map(rows)
+  peers.set('worlds', [{ ...roots.worlds[0], id: 1, projectId: 1 }])
+  peers.set('works', [{ ...roots.works[0], id: 1, projectId: 1, worldId: 1 }])
+  return { registry, scope: { projectId: 1, worldId: 1, workId: 1 },
+    owner: { kind: 'world', worldCode: input.worldCode, sourceWorkCode }, rows, peers,
+    worldCode: input.worldCode, workCode: roots.works[0].code as string }
+}
+
+async function verifyContentSources(content: Omit<WorldReleaseSemanticContentV4, 'narrative'>): Promise<NarrativeDomainCaptureV1> {
+  exact(object(content, 'content'), CONTENT_KEYS.filter(key => key !== 'narrative'), 'content')
+  if (content.schema !== 'storyforge.world-release' || content.version !== 4 || content.semanticContract !== 4
+    || content.registryVersion !== 'world-semantic-v4' || content.compilerVersion !== 'narrative-domain-v1') {
+    narrativeFail('release-version', '只接受该版本的 v4 世界内容合同')
+  }
+  keyV1(content.worldName, 'worldName')
+  const { lineage, ...sourceFields } = object(content.sourceManifest, 'sourceManifest')
+  const source = objectV1<Omit<WorldReleaseSemanticContentV4['sourceManifest'], 'lineage'>>({
+    sourceKind: enumV1(['world-draft']), sourceWorkspaceUid: keyV1, sourceWorldCode: keyV1,
+    sourceWorkCode: value => {
+      if (value !== null && !isWorkCode(value)) narrativeFail('release-lineage', 'Work 来源必须是明确的稳定身份')
+      return value as string | null
+    },
+  })(sourceFields, 'sourceManifest')
+  if ('lineage' in content.sourceManifest) await verifyNarrativeLineageV1(lineage, content.worldCode)
+  if (source.sourceWorldCode !== content.worldCode || source.sourceWorkspaceUid !== content.semanticSnapshot.project.workspaceUid
+    || content.semanticSnapshot.worlds[0].name !== content.worldName) narrativeFail('release-source', '封存来源与语义根不一致')
+  return captureFrozenNarrativeSourcesV4({ ...content, sourceWorkCode: source.sourceWorkCode })
+}
+
+async function verifyContent(content: WorldReleaseSemanticContentV4): Promise<void> {
+  exact(object(content, 'content'), CONTENT_KEYS, 'content')
+  const { narrative: _narrative, ...originals } = content
+  const capture = await verifyContentSources(originals)
+  // Rebuild coverage, permissions, evidence and all atoms from the same frozen
+  // originals. Merely re-hashing a fabricated projection cannot pass.
+  const expected = await attachNarrativeLineageV1(await projectNarrativeDomainCaptureV1(capture, { branchKey: 'canon' }), content.sourceManifest.lineage)
+  if (!equalNarrativeJsonV1(content.narrative, expected)) {
+    narrativeFail('release-projection', '冻结投影与原文、确认、覆盖或权限不一致')
+  }
+}
+
+/** Compile a release component; persistence, author authorization and final
+ * compare-and-swap are owned by createWorldRevision, not this pure function. */
+export async function prepareNarrativeReleaseContentV4(input: Omit<WorldReleaseSemanticContentV4, 'narrative'>) {
+  assertNarrativeJsonV1(input)
+  const frozen = structuredClone(input)
+  const capture = await verifyContentSources(frozen)
+  const narrative = await attachNarrativeLineageV1(await projectNarrativeDomainCaptureV1(capture, { branchKey: 'canon' }), frozen.sourceManifest.lineage)
+  const content = { ...frozen, narrative }
+  // The projection above was built here from a private frozen input. External
+  // manifests still recompile in verifyContent; a compiler need not repeat its
+  // own identical projection just to compare that result with itself.
+  return { content, semanticRootHash: await hashNarrativeValueV1(content) }
+}
+
+export async function compileWorldReleaseContentV4(input: Omit<WorldReleaseSemanticContentV4, 'narrative'>): Promise<WorldReleaseCompiledV4> {
+  const { content, semanticRootHash } = await prepareNarrativeReleaseContentV4(input)
+  const narrative = content.narrative
+  const index = await compileNarrativeIndexV1({ inputRootHash: semanticRootHash, projection: narrative,
+    predicates: WORLD_SEMANTIC_REGISTRY_V4.predicates, retainIncrementalShards: false })
+  const manifest: WorldReleaseManifestV4 = { ...content, semanticRootHash,
+    indexDescriptor: { inputRootHash: semanticRootHash, recipeVersion: index.recipeVersion, indexHash: index.indexHash } }
+  const manifestJson = canonicalNarrativeJsonV1(manifest)
+  return { manifest, manifestJson, contentHash: await hashNarrativeBytesV1(manifestJson), index }
+}
+
+export async function verifyWorldReleaseContentV4(input: {
+  manifest: string | unknown
+  expectedContentHash?: string
+  expectedWorldCode?: string
+  index?: unknown
+  mode?: 'complete' | 'source-only'
+  /** Private shard copies are needed only when this verified index will be an
+   * incremental baseline, not for ordinary reads or package verification. */
+  retainIncrementalShards?: boolean
+}): Promise<{ manifest: WorldReleaseManifestV4; index: NarrativeIndexV1 | null; readiness: 'ready' | 'rebuilt' | 'unavailable' }> {
+  const parsed = parse(input.manifest)
+  exact(parsed, [...CONTENT_KEYS, 'semanticRootHash', 'indexDescriptor'], 'manifest')
+  const manifest = parsed as unknown as WorldReleaseManifestV4
+  hashV1(manifest.semanticRootHash, 'semanticRootHash')
+  const descriptor = objectV1<WorldReleaseManifestV4['indexDescriptor']>({ inputRootHash: hashV1, recipeVersion: keyV1, indexHash: hashV1 })(manifest.indexDescriptor, 'indexDescriptor')
+  if (input.expectedContentHash !== undefined && await (typeof input.manifest === 'string'
+    ? hashNarrativeBytesV1(input.manifest) : hashNarrativeValueV1(manifest)) !== hashV1(input.expectedContentHash, 'expectedContentHash')) narrativeFail('release-hash', '世界内容 hash 不匹配')
+  if (input.expectedWorldCode !== undefined && input.expectedWorldCode !== manifest.worldCode) narrativeFail('release-world', '世界身份与外层绑定不一致')
+  await verifyContent(contentOf(manifest))
+  if (await hashNarrativeValueV1(contentOf(manifest)) !== manifest.semanticRootHash || descriptor.inputRootHash !== manifest.semanticRootHash) {
+    narrativeFail('release-semantic-root', '原文、IR 和索引输入根不一致')
+  }
+  if (descriptor.recipeVersion !== NARRATIVE_INDEX_RECIPE_V1) {
+    if (input.mode !== 'source-only') narrativeFail('release-recipe', '索引配方不可用；只能显式读取原始内容')
+    return { manifest, index: null, readiness: 'unavailable' }
+  }
+  const indexInput = { inputRootHash: manifest.semanticRootHash, projection: manifest.narrative,
+    predicates: WORLD_SEMANTIC_REGISTRY_V4.predicates, retainIncrementalShards: input.retainIncrementalShards === true }
+  const index = input.index === undefined ? await compileNarrativeIndexV1(indexInput) : await verifyNarrativeIndexV1(input.index, indexInput)
+  if (index.indexHash !== descriptor.indexHash) narrativeFail('release-index-hash', '按原配方重建的索引与冻结承诺不同')
+  return { manifest, index, readiness: input.index === undefined ? 'rebuilt' : 'ready' }
+}
diff --git a/src/lib/world-engine/narrative-release-worker.ts b/src/lib/world-engine/narrative-release-worker.ts
new file mode 100644
index 00000000..3c9161b7
--- /dev/null
+++ b/src/lib/world-engine/narrative-release-worker.ts
@@ -0,0 +1,82 @@
+import type { WorldReleaseSemanticContentV4 } from '../types/narrative-release'
+import type { NarrativeCompilationResultV1, NarrativeIncrementalBaseV1 } from './narrative-incremental'
+import { canonicalNarrativeJsonV1, hashNarrativeValueV1 } from './narrative-json'
+
+export const NARRATIVE_COMPILE_WORKER_BUDGET_V1 = Object.freeze({ inputBytes: 32 * 1024 * 1024, timeoutMs: 60_000 })
+export type NarrativeCompileProgressV1 = 'worker-started' | 'inline-fallback'
+function aborted(): Error { return new DOMException('叙事世界编译已取消，原封存保留', 'AbortError') }
+
+async function verifyWorkerTransfer(input: Omit<WorldReleaseSemanticContentV4, 'narrative'>, result: NarrativeCompilationResultV1): Promise<NarrativeCompilationResultV1> {
+  if (!result?.manifest || !result.index || typeof result.manifestJson !== 'string') throw Error('[narrative-worker] 后台未返回完整编译结果')
+  const { narrative, semanticRootHash, indexDescriptor, ...source } = result.manifest
+  const { indexHash, ...indexBody } = result.index
+  if (canonicalNarrativeJsonV1(source) !== canonicalNarrativeJsonV1(input)
+    || canonicalNarrativeJsonV1(result.manifest) !== result.manifestJson
+    || await hashNarrativeValueV1(result.manifest) !== result.contentHash
+    || await hashNarrativeValueV1({ ...source, narrative }) !== semanticRootHash
+    || indexDescriptor.inputRootHash !== semanticRootHash || result.index.inputRootHash !== semanticRootHash
+    || indexDescriptor.recipeVersion !== result.index.recipeVersion || indexDescriptor.indexHash !== indexHash
+    || await hashNarrativeValueV1(indexBody) !== indexHash) throw Error('[narrative-worker] 后台传输结果与捕获来源或 hash 不一致')
+  return result
+}
+
+/** Registered pure compiler in a dedicated worker. A platform without Worker
+ * explicitly reports inline fallback. A dispatched worker failure never
+ * silently retries; callers retain their checkpoint and previous release. */
+export async function compileNarrativeReleaseInWorkerV1(input: Omit<WorldReleaseSemanticContentV4, 'narrative'>, options: {
+  baseline?: NarrativeIncrementalBaseV1
+  signal?: AbortSignal
+  onProgress?: (phase: NarrativeCompileProgressV1) => void
+} = {}): Promise<NarrativeCompilationResultV1> {
+  if (options.signal?.aborted) throw aborted()
+  const bytes = canonicalNarrativeJsonV1(input)
+  const baseline = options.baseline && JSON.parse(canonicalNarrativeJsonV1(options.baseline)) as NarrativeIncrementalBaseV1 | undefined
+  if (new TextEncoder().encode(bytes).byteLength + (baseline ? new TextEncoder().encode(canonicalNarrativeJsonV1(baseline)).byteLength : 0) > NARRATIVE_COMPILE_WORKER_BUDGET_V1.inputBytes) throw Error('[narrative-worker] 捕获内容超过后台编译预算')
+  const frozen = JSON.parse(bytes) as typeof input
+  let result: NarrativeCompilationResultV1
+  if (typeof Worker === 'undefined') {
+    options.onProgress?.('inline-fallback')
+    const { compileWorldReleaseContentV4 } = await import('./narrative-release-v4')
+    if (options.signal?.aborted) throw aborted()
+    result = baseline ? await (await import('./narrative-incremental')).compileNarrativeReleaseIncrementalV1(frozen, baseline) : await compileWorldReleaseContentV4(frozen)
+  } else {
+    result = await new Promise<NarrativeCompilationResultV1>((resolve, reject) => {
+      const worker = new Worker(new URL('./narrative-release.worker.ts', import.meta.url), { type: 'module' })
+      let finished = false
+      const cleanup = () => { clearTimeout(timer); options.signal?.removeEventListener('abort', onAbort); worker.terminate() }
+      const finish = (error?: Error, value?: NarrativeCompilationResultV1) => {
+        if (finished) return
+        finished = true; cleanup()
+        if (error) reject(error); else resolve(value!)
+      }
+      const onAbort = () => finish(aborted())
+      const timer = setTimeout(() => finish(Error('[narrative-worker] 后台编译超时，未写入新封存')), NARRATIVE_COMPILE_WORKER_BUDGET_V1.timeoutMs)
+      options.signal?.addEventListener('abort', onAbort, { once: true })
+      worker.onmessage = event => {
+        if (event.data?.status === 'compiling') {
+          try { options.onProgress?.('worker-started') } catch (error) { finish(error instanceof Error ? error : Error('编译进度处理失败')) }
+        } else if (event.data?.status === 'complete') finish(undefined, event.data.result as NarrativeCompilationResultV1)
+        else if (event.data?.status === 'failed') finish(Error('[narrative-worker] ' + String(event.data.error)))
+        else finish(Error('[narrative-worker] 后台返回未知状态'))
+      }
+      worker.onerror = () => finish(Error('[narrative-worker] 后台编译被中断，未写入新封存'))
+      worker.onmessageerror = () => finish(Error('[narrative-worker] 无法传输编译结果'))
+      if (options.signal?.aborted) onAbort()
+      else {
+        try { worker.postMessage({ version: 1, input: frozen, baseline }) }
+        catch (error) { finish(error instanceof Error ? error : Error('无法发送编译输入')) }
+      }
+    })
+  }
+  if (options.signal?.aborted) throw aborted()
+  if (baseline) {
+    const update = result.update
+    if (!update || update.version !== 1 || update.baseContentHash !== baseline.contentHash
+      || update.impact.nextRevisionVector.semanticRootHash !== result.manifest.semanticRootHash) throw Error('[narrative-worker] 增量回执缺失或绑定错误')
+    const { planHash, ...body } = update.impact
+    if (await hashNarrativeValueV1(body) !== planHash) throw Error('[narrative-worker] 修改影响计划传输校验失败')
+  } else if (result.update) throw Error('[narrative-worker] 全量任务不能接收未请求的增量回执')
+  const verified = await verifyWorkerTransfer(frozen, result)
+  if (options.signal?.aborted) throw aborted()
+  return verified
+}
diff --git a/src/lib/world-engine/narrative-release.worker.ts b/src/lib/world-engine/narrative-release.worker.ts
new file mode 100644
index 00000000..da09d7ed
--- /dev/null
+++ b/src/lib/world-engine/narrative-release.worker.ts
@@ -0,0 +1,18 @@
+import { compileNarrativeReleaseIncrementalV1, type NarrativeIncrementalBaseV1 } from './narrative-incremental'
+import { compileWorldReleaseContentV4 } from './narrative-release-v4'
+import type { WorldReleaseSemanticContentV4 } from '../types/narrative-release'
+
+// One dedicated worker per bounded task. No database mutations or model calls.
+const endpoint = self as unknown as { onmessage: ((event: MessageEvent) => void) | null; postMessage: (value: unknown) => void }
+let started = false
+endpoint.onmessage = event => {
+  if (started) return
+  started = true
+  const request = event.data as { version: number; input: Omit<WorldReleaseSemanticContentV4, 'narrative'>; baseline?: NarrativeIncrementalBaseV1 }
+  if (request?.version !== 1) { endpoint.postMessage({ status: 'failed', error: '未知编译 Worker 请求版本' }); return }
+  endpoint.postMessage({ status: 'compiling' })
+  void (request.baseline ? compileNarrativeReleaseIncrementalV1(request.input, request.baseline) : compileWorldReleaseContentV4(request.input)).then(
+    result => endpoint.postMessage({ status: 'complete', result }),
+    error => endpoint.postMessage({ status: 'failed', error: error instanceof Error ? error.message : '后台编译失败' }),
+  )
+}
