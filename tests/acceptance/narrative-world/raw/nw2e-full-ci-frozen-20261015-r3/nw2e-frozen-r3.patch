+++ b/src/lib/world-engine/narrative-domain-registry.ts
@@ -0,0 +1,25 @@
+import { PROJECT_TABLES } from '../registry/project-tables'
+import { FACT_PREDICATE_REGISTRY } from '../registry/fact-predicate-registry'
+import { CANON_ASSERTION_SOURCE_REGISTRY } from '../registry/canon-assertion-source-registry'
+import type { NarrativeDomainRegistryV1, NarrativeDomainTableContractV1 } from '../types/narrative-domain-registry'
+
+/** Capture only interpretation metadata, never database handles or user rows. */
+export function currentNarrativeDomainRegistryV1(): NarrativeDomainRegistryV1 {
+  return {
+    version: 1,
+    tables: PROJECT_TABLES.filter(spec => spec.worldSemantic).map(spec => {
+      const { name, worldSemantic, resourceIdentity, domainOwner, worldScoped, worldGroupField, homeWorldScoped,
+        exportRemap, exportRefRemap, exportIdField, tree, selfIdPaths } = spec
+      return JSON.parse(JSON.stringify({ name, worldSemantic, resourceIdentity, domainOwner, worldScoped,
+        worldGroupField, homeWorldScoped, exportRemap, exportRefRemap, exportIdField, tree, selfIdPaths })) as NarrativeDomainTableContractV1
+    }),
+    evidenceFields: Object.fromEntries(CANON_ASSERTION_SOURCE_REGISTRY.map(spec => [spec.table, spec.fields.map(field => field.field)])),
+    predicates: JSON.parse(JSON.stringify(FACT_PREDICATE_REGISTRY)),
+  }
+}
+
+export function narrativeDomainTableV1(registry: NarrativeDomainRegistryV1, table: string): NarrativeDomainTableContractV1 {
+  const spec = registry.tables.find(item => item.name === table)
+  if (!spec) throw new Error(`[narrative-contract:table] ${table} 不属于该版本的语义合同`)
+  return spec
+}
diff --git a/src/lib/world-engine/narrative-incremental.ts b/src/lib/world-engine/narrative-incremental.ts
new file mode 100644
index 00000000..f1d6571e
--- /dev/null
+++ b/src/lib/world-engine/narrative-incremental.ts
@@ -0,0 +1,62 @@
+import type { WorldReleaseCompiledV4, WorldReleaseSemanticContentV4, WorldReleaseManifestV4 } from '../types/narrative-release'
+import type { WorldImpactPlanV1 } from '../types/world-impact'
+import type { NarrativeIndexReuseReceiptV1 } from './narrative-index'
+import { buildWorldImpactPlanV1 } from '../consistency/world-impact'
+import { prepareNarrativeReleaseContentV4, verifyWorldReleaseContentV4 } from './narrative-release-v4'
+import { compileNarrativeIndexIncrementalV1 } from './narrative-index'
+import { WORLD_SEMANTIC_REGISTRY_V4 } from './semantic-registry-v4'
+import { canonicalNarrativeJsonV1, hashNarrativeValueV1, narrativeFail } from './narrative-json'
+
+export interface NarrativeIncrementalBaseV1 { version: 1; manifestJson: string; contentHash: string }
+export interface NarrativeUpdateReceiptV1 {
+  version: 1
+  baseContentHash: string
+  baseVerification: 'full-frozen-recipe'
+  impact: WorldImpactPlanV1
+  indexReuse: NarrativeIndexReuseReceiptV1
+  automaticCanonWrites: 0
+}
+export type NarrativeCompilationResultV1 = WorldReleaseCompiledV4 & { update?: NarrativeUpdateReceiptV1 }
+
+function impactSnapshot(content: WorldReleaseSemanticContentV4, semanticRootHash: string) {
+  const lockedSources = new Set<string>()
+  const originals: Array<{ sourceKey: string; fields: Record<string, unknown> }> = []
+  for (const spec of WORLD_SEMANTIC_REGISTRY_V4.tables) {
+    for (const row of content.records[spec.name] ?? []) if (spec.resourceIdentity) {
+      const sourceKey = `${spec.resourceIdentity.contextKind}:${row[spec.resourceIdentity.field]}`
+      if (row.locked === true) lockedSources.add(sourceKey)
+      // Portable FK locators and annotation bindings are handled by verified
+      // IR references. Keep non-IR original business fields visible as gaps.
+      originals.push({ sourceKey, fields: Object.fromEntries(Object.entries(row).filter(([key]) => !key.startsWith('_')
+        && !key.startsWith('narrative') && ![spec.resourceIdentity!.field, 'createdAt', 'updatedAt'].includes(key))) })
+    }
+  }
+  return { projection: content.narrative, semanticRootHash, originals,
+    lockedSemanticIds: content.narrative.bundle.records.filter(record => lockedSources.has(record.provenance.sourceResourceKey)).map(record => record.semanticId) }
+}
+
+export async function planNarrativeReleaseUpdateV1(base: WorldReleaseManifestV4, next: WorldReleaseSemanticContentV4, nextRootHash: string) {
+  return buildWorldImpactPlanV1({ base: impactSnapshot(base, base.semanticRootHash), next: impactSnapshot(next, nextRootHash),
+    predicates: WORLD_SEMANTIC_REGISTRY_V4.predicates })
+}
+
+/** A cold worker verifies/rebuilds the old recipe once to obtain private shard
+ * capabilities. New chunks and lexical shards are then computed only where
+ * their exact inputs changed. IR validation and global graph assembly remain
+ * full, and are honestly recorded in the receipt. Nothing is persisted here. */
+export async function compileNarrativeReleaseIncrementalV1(input: Omit<WorldReleaseSemanticContentV4, 'narrative'>,
+  baseline: NarrativeIncrementalBaseV1): Promise<NarrativeCompilationResultV1> {
+  if (baseline.version !== 1) narrativeFail('incremental-version', '增量基线版本不受支持')
+  const base = await verifyWorldReleaseContentV4({ manifest: baseline.manifestJson, expectedContentHash: baseline.contentHash,
+    expectedWorldCode: input.worldCode, retainIncrementalShards: true })
+  const { content, semanticRootHash } = await prepareNarrativeReleaseContentV4(input)
+  const impact = await planNarrativeReleaseUpdateV1(base.manifest, content, semanticRootHash)
+  const incremental = await compileNarrativeIndexIncrementalV1({ inputRootHash: semanticRootHash, projection: content.narrative,
+    predicates: WORLD_SEMANTIC_REGISTRY_V4.predicates }, base.index!)
+  const index = incremental.index
+  const manifest: WorldReleaseManifestV4 = { ...content, semanticRootHash,
+    indexDescriptor: { inputRootHash: semanticRootHash, recipeVersion: index.recipeVersion, indexHash: index.indexHash } }
+  return { manifest, manifestJson: canonicalNarrativeJsonV1(manifest), contentHash: await hashNarrativeValueV1(manifest), index,
+    update: { version: 1, baseContentHash: baseline.contentHash, baseVerification: 'full-frozen-recipe', impact,
+      indexReuse: incremental.receipt, automaticCanonWrites: 0 } }
+}
diff --git a/src/lib/world-engine/narrative-index-cache.ts b/src/lib/world-engine/narrative-index-cache.ts
new file mode 100644
index 00000000..83ac6b12
--- /dev/null
+++ b/src/lib/world-engine/narrative-index-cache.ts
@@ -0,0 +1,150 @@
+import Dexie from 'dexie'
+import { db } from '../db/schema'
+import type { WorldRelease } from '../types'
+import type { WorldNarrativeIndexCacheV1 } from '../types/narrative-index-cache'
+import { verifyWorldReleaseManifestV1, type VerifiedWorldReleaseV1 } from './release-codec'
+import { boundedCanonicalNarrativeJsonV1, canonicalNarrativeJsonV1, narrativeUtf8ByteLengthV1 } from './narrative-json'
+
+export const NARRATIVE_INDEX_CACHE_LIMITS_V1 = Object.freeze({ maxEntries: 8, maxBytes: 64 * 1024 * 1024, maxEntryBytes: 16 * 1024 * 1024 })
+type Scope = { projectId: number; worldId: number }
+type VerifiedV4 = Extract<VerifiedWorldReleaseV1, { version: 4 }>
+export type NarrativeIndexCacheStateV1 = 'memory' | 'stored' | 'rebuilt' | 'unavailable' | 'budget-exceeded'
+export interface WorldNarrativeIndexReadV1 {
+  release: WorldRelease
+  verified: VerifiedV4
+  cacheState: NarrativeIndexCacheStateV1
+  diagnostics: string[]
+}
+const memory = new Map<string, { releaseJson: string; verifiedJson: string; bytes: number }>()
+const size = narrativeUtf8ByteLengthV1
+const key = (scope: Scope, releaseId: number) => `${scope.projectId}:${scope.worldId}:${releaseId}`
+class StaleReleaseError extends Error {}
+
+async function assertScope(scope: Scope): Promise<void> {
+  const world = await db.worlds.get(scope.worldId)
+  if (!world || world.projectId !== scope.projectId || !await db.projects.get(scope.projectId)) throw Error('[narrative-index-cache] World 不属于请求工作区')
+}
+function releaseMatches(a: WorldRelease | undefined, b: WorldRelease): boolean {
+  return !!a && a.id === b.id && a.projectId === b.projectId && a.worldId === b.worldId
+    && a.releaseUid === b.releaseUid && a.contentHash === b.contentHash && a.sourceWorldCode === b.sourceWorldCode
+    && a.manifestJson === b.manifestJson
+}
+async function assertCurrent(release: WorldRelease): Promise<void> {
+  if (!releaseMatches(await db.worldReleases.get(release.id!), release)) throw new StaleReleaseError('[narrative-index-cache] 核验期间封存记录已变化或删除')
+}
+async function readRelease(scope: Scope, releaseId: number): Promise<WorldRelease> {
+  return db.transaction('r', db.projects, db.worlds, db.worldReleases, async () => {
+    await Dexie.Promise.resolve(assertScope(scope))
+    const release = await db.worldReleases.get(releaseId)
+    if (!release || release.projectId !== scope.projectId || release.worldId !== scope.worldId) throw Error('[narrative-index-cache] Release 不属于请求 World')
+    return release
+  })
+}
+function remember(scope: Scope, release: WorldRelease, verified: VerifiedV4): void {
+  const cacheKey = key(scope, release.id!), limit = NARRATIVE_INDEX_CACHE_LIMITS_V1.maxEntryBytes
+  memory.delete(cacheKey)
+  // UTF-16 length is a lower bound on canonical UTF-8 bytes. Do not encode
+  // an already oversized manifest just to discard its disposable cache.
+  if (release.manifestJson.length > limit) return
+  const releaseJson = boundedCanonicalNarrativeJsonV1(release, limit)
+  if (releaseJson === null) return
+  const releaseBytes = size(releaseJson)
+  const verifiedJson = boundedCanonicalNarrativeJsonV1(verified, limit - releaseBytes)
+  if (verifiedJson === null) return
+  const bytes = releaseBytes + size(verifiedJson)
+  memory.set(cacheKey, { releaseJson, verifiedJson, bytes })
+  let total = [...memory.values()].reduce((sum, row) => sum + row.bytes, 0)
+  while (memory.size > NARRATIVE_INDEX_CACHE_LIMITS_V1.maxEntries || total > NARRATIVE_INDEX_CACHE_LIMITS_V1.maxBytes) {
+    const oldest = memory.keys().next().value as string
+    total -= memory.get(oldest)!.bytes
+    memory.delete(oldest)
+  }
+}
+async function storeVerified(release: WorldRelease, verified: VerifiedV4): Promise<'stored' | 'budget-exceeded'> {
+  if (!verified.index) return 'budget-exceeded'
+  const indexJson = boundedCanonicalNarrativeJsonV1(verified.index, NARRATIVE_INDEX_CACHE_LIMITS_V1.maxEntryBytes)
+  if (indexJson === null) return 'budget-exceeded'
+  const byteLength = size(indexJson)
+  return db.transaction('rw', db.worldNarrativeIndexCaches, db.worldReleases, async () => {
+    await Dexie.Promise.resolve(assertCurrent(release))
+    const previous = await db.worldNarrativeIndexCaches.where('releaseId').equals(release.id!).first(), now = Date.now()
+    const row: WorldNarrativeIndexCacheV1 = { id: previous?.id, projectId: release.projectId, worldId: release.worldId,
+      releaseId: release.id!, releaseUid: release.releaseUid!, contentHash: release.contentHash,
+      inputRootHash: verified.manifest.semanticRootHash, recipeVersion: verified.index!.recipeVersion,
+      indexHash: verified.index!.indexHash, indexJson, byteLength, createdAt: previous?.createdAt ?? now, lastAccessedAt: now }
+    const id = await db.worldNarrativeIndexCaches.put(row)
+    const rows = (await db.worldNarrativeIndexCaches.toArray()).sort((a, b) => b.lastAccessedAt - a.lastAccessedAt || b.id! - a.id!)
+    let bytes = 0, count = 0
+    const remove: number[] = []
+    for (const item of rows) {
+      // Never trust a persisted byteLength for eviction accounting.
+      const actualBytes = typeof item.indexJson === 'string' ? size(item.indexJson) : Infinity
+      if (actualBytes > NARRATIVE_INDEX_CACHE_LIMITS_V1.maxEntryBytes || count >= NARRATIVE_INDEX_CACHE_LIMITS_V1.maxEntries
+        || bytes + actualBytes > NARRATIVE_INDEX_CACHE_LIMITS_V1.maxBytes) remove.push(item.id!)
+      else { bytes += actualBytes; count++ }
+    }
+    await db.worldNarrativeIndexCaches.bulkDelete(remove)
+    return remove.includes(id) ? 'budget-exceeded' : 'stored'
+  })
+}
+
+/** Internal frozen-world loading boundary. Readers must still apply their
+ * Context Gateway audience/policy before exposing any content. Persistent
+ * cache bytes are fully verified once per process; only a bounded immutable
+ * memory copy avoids repeated compilation. No model or network is used. */
+export async function readWorldNarrativeIndexV1(input: Scope & { releaseId: number }): Promise<WorldNarrativeIndexReadV1> {
+  const request = { ...input }, scope = { projectId: input.projectId, worldId: input.worldId }
+  const release = await readRelease(scope, request.releaseId), cacheKey = key(scope, request.releaseId)
+  const memo = memory.get(cacheKey)
