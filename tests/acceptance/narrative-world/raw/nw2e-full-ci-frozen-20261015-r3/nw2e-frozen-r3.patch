diff --git a/src/lib/world-engine/narrative-domain-authoring.ts b/src/lib/world-engine/narrative-domain-authoring.ts
new file mode 100644
index 00000000..7ad6d6c9
--- /dev/null
+++ b/src/lib/world-engine/narrative-domain-authoring.ts
@@ -0,0 +1,101 @@
+import Dexie from 'dexie'
+import { db } from '../db/schema'
+import { REGISTRY_BY_NAME } from '../registry/project-tables'
+import { FIELD_BY_TARGET } from '../registry/field-registry'
+import { isPortableResourceUidV1 } from '../context-gateway/resource-uid'
+import type { WorkspaceScope } from '../types/world-ownership'
+import type { NarrativeOwnerV1 } from '../types/narrative-ir'
+import type { NarrativeDomainAuthorityV1, NarrativeDomainFieldsV1 } from '../types/narrative-domain'
+import { captureNarrativeDomainInTransactionV1, hashNarrativeDomainSourceV1, narrativeDomainCaptureTablesV1,
+  type NarrativeDomainCaptureV1, type NarrativeDomainRowV1 } from './narrative-domain-capture'
+import { mapNarrativeDomainReferencesV1, parseNarrativeDomainFieldV1, type NarrativeDomainFieldV1 } from '../narrative-domain/codec'
+import { compileNarrativeDomainEvidenceV1, resolveNarrativeDomainReferenceV1 } from './narrative-domain-evidence'
+import { canonicalNarrativeJsonV1, hashV1, narrativeFail } from './narrative-json'
+
+function assertNoConfirmationReceipt(value: unknown): void {
+  if (Array.isArray(value)) { value.forEach(assertNoConfirmationReceipt); return }
+  if (!value || typeof value !== 'object') return
+  if (Object.prototype.hasOwnProperty.call(value, 'narrativeAuthorityV1')) narrativeFail('authority', '输入不得包含系统确认凭据')
+  Object.values(value).forEach(assertNoConfirmationReceipt)
+}
+
+interface ConfirmationInput {
+  table: string
+  expectedSourceHash: string
+  annotations: Partial<Omit<NarrativeDomainFieldsV1, 'narrativeAuthorityV1'>>
+  clearFields?: NarrativeDomainFieldV1[]
+}
+
+/** Pure preparation shared by explicit author confirmation and an explicitly
+ * requested copy of already-confirmed meaning. Never writes or grants a model
+ * adoption permission; persistence still belongs to the caller's CAS. */
+export async function prepareNarrativeDomainConfirmationV1(input: ConfirmationInput & {
+  capture: NarrativeDomainCaptureV1; current: NarrativeDomainRowV1
+}): Promise<{ row: NarrativeDomainRowV1; receipt: NarrativeDomainAuthorityV1; changed: boolean }> {
+  hashV1(input.expectedSourceHash, 'expectedSourceHash')
+  canonicalNarrativeJsonV1(input.annotations)
+  assertNoConfirmationReceipt(input.annotations)
+  const spec = REGISTRY_BY_NAME.get(input.table)
+  if (!spec?.worldSemantic?.projector) narrativeFail('projector', '来源未登记叙事确认入口')
+  const fields = FIELD_BY_TARGET.get(input.table) ?? []
+  const patch: Record<string, unknown> = {}
+  for (const [field, value] of Object.entries(input.annotations)) {
+    if (!fields.some(item => item.field === field && item.adoptionPolicy === 'narrative-annotation-v1')) {
+      narrativeFail('domain-field', `${input.table}.${field} 不能通过此入口写入`)
+    }
+    patch[field] = parseNarrativeDomainFieldV1(field as NarrativeDomainFieldV1, value)
+  }
+  for (const field of input.clearFields ?? []) {
+    if (field in patch || !fields.some(item => item.field === field && item.adoptionPolicy === 'narrative-annotation-v1')) {
+      narrativeFail('domain-field', '清除字段未登记或与写入字段冲突')
+    }
+  }
+  const { capture, current } = input
+  if (!capture.rows.get(input.table)?.includes(current)) narrativeFail('scope', '确认记录不属于当前作用域')
+  if (!spec.resourceIdentity || !isPortableResourceUidV1(current[spec.resourceIdentity.field], spec.resourceIdentity.resourceKind)) {
+    narrativeFail('source-uid', '旧来源缺少稳定身份，不能由确认或投影静默补写')
+  }
+  if (await hashNarrativeDomainSourceV1(capture, input.table, current) !== input.expectedSourceHash) {
+    narrativeFail('stale', '来源或注释已变化，请重新审阅后确认')
+  }
+  const next = { ...current, ...patch }
+  for (const field of input.clearFields ?? []) delete next[field]
+  for (const field of spec.worldSemantic!.projector!.annotationFields) {
+    if (next[field] === undefined) continue
+    mapNarrativeDomainReferencesV1(field, next[field], reference => {
+      resolveNarrativeDomainReferenceV1(capture, reference)
+      return reference
+    })
+  }
+  const groups = [next, ...(next.narrativeDevelopmentsV1 ?? []), ...(next.narrativeDisclosuresV1 ?? [])]
+  for (const group of groups) for (const evidence of group.narrativeEvidenceV1 ?? []) {
+    await compileNarrativeDomainEvidenceV1(capture, input.table, next, evidence, evidence.evidenceKey)
+  }
+  const contentHash = await hashNarrativeDomainSourceV1(capture, input.table, next)
+  if (current.narrativeAuthorityV1?.contentHash === contentHash) return { row: current, receipt: current.narrativeAuthorityV1, changed: false }
+  const receipt: NarrativeDomainAuthorityV1 = { version: 1, confirmationUid: `confirmation:v1:${crypto.randomUUID()}`,
+    mode: 'author-declaration', confirmedAt: Date.now(), contentHash }
+  return { row: { ...next, narrativeAuthorityV1: receipt, updatedAt: receipt.confirmedAt }, receipt, changed: true }
+}
+
+/** Explicit author declaration extension, not a generic model tool. The caller
+ * must display the source and proposed annotations before the author confirms.
+ * Candidate adoption binds its durable receipt through the same CAS seam. */
+export async function confirmNarrativeDomainAnnotationsV1(input: ConfirmationInput & {
+  scope: WorkspaceScope; owner?: NarrativeOwnerV1; recordId: number
+}): Promise<NarrativeDomainAuthorityV1> {
+  input = structuredClone(input)
+  return db.transaction('rw', narrativeDomainCaptureTablesV1(), async () => {
+    const work = await db.works.get(input.scope.workId)
+    if (!work) narrativeFail('owner', '作品不存在')
+    const capture = await Dexie.Promise.resolve(captureNarrativeDomainInTransactionV1({ scope: input.scope,
+      owner: input.owner ?? { kind: 'work', workCode: work.code } }))
+    const current = capture.rows.get(input.table)?.find(row => row.id === input.recordId)
+    if (!current) narrativeFail('scope', '确认记录不属于当前作用域')
+    const prepared = await Dexie.waitFor(prepareNarrativeDomainConfirmationV1({ ...input, capture, current }))
+    // Replace only the checked record. clearFields is explicit, no spread of
+    // untrusted owner IDs, compiled IR, or unregistered payload fields.
+    if (prepared.changed) await REGISTRY_BY_NAME.get(input.table)!.table.put(prepared.row)
+    return prepared.receipt
+  })
+}
diff --git a/src/lib/world-engine/narrative-domain-capture.ts b/src/lib/world-engine/narrative-domain-capture.ts
new file mode 100644
index 00000000..84fad945
--- /dev/null
+++ b/src/lib/world-engine/narrative-domain-capture.ts
@@ -0,0 +1,149 @@
+import Dexie from 'dexie'
+import { db } from '../db/schema'
+import { PROJECT_TABLES } from '../registry/project-tables'
+import { assertRecordInScope, resolveReadScope, scopeTransactionTables } from '../workspace/scope'
+import type { WorkspaceScope } from '../types/world-ownership'
+import type { NarrativeOwnerV1 } from '../types/narrative-ir'
+import type { NarrativeDomainRegistryV1 } from '../types/narrative-domain-registry'
+import { currentNarrativeDomainRegistryV1, narrativeDomainTableV1 } from './narrative-domain-registry'
+import type { NarrativeDomainFieldsV1 } from '../types/narrative-domain'
+import { NARRATIVE_DOMAIN_FIELDS_V1, parseNarrativeDomainFieldV1 } from '../narrative-domain/codec'
+import { portableNarrativeDomainFieldJsonV1 } from '../narrative-domain/references'
+import { compareUnicodeCodePointsV1, hashNarrativeValueV1, narrativeFail } from './narrative-json'
+import { ownerDecoderV1 } from './narrative-identity'
+
+export type NarrativeDomainRowV1 = Record<string, unknown> & NarrativeDomainFieldsV1
+export interface NarrativeDomainCaptureV1 {
+  scope: WorkspaceScope
+  registry: NarrativeDomainRegistryV1
+  owner: NarrativeOwnerV1
+  /** All selected scope rows, captured in one IndexedDB read transaction. */
+  rows: Map<string, NarrativeDomainRowV1[]>
+  /** Peers retain UID collision evidence, including another Work in the project. */
+  peers: Map<string, NarrativeDomainRowV1[]>
+  worldCode: string
+  workCode: string
+}
+
+export function narrativeDomainCaptureTablesV1() {
+  return scopeTransactionTables(...PROJECT_TABLES.filter(spec => spec.worldSemantic).map(spec => spec.table))
+}
+
+function isWorldOwned(rows: ReadonlyMap<string, NarrativeDomainRowV1[]>, table: string, row: NarrativeDomainRowV1,
+  registry: NarrativeDomainRegistryV1, visited = new Set<string>()): boolean {
+  const locator = narrativeDomainTableV1(registry, table).domainOwner!.locator
+  if (locator.kind === 'field') return locator.owner === 'world'
+  if (locator.kind === 'exclusive-fields') return row[locator.worldField] != null && row[locator.workField] == null
+  if (locator.kind !== 'parent') return false
+  const key = `${table}:${row.id}`
+  if (visited.has(key)) narrativeFail('owner-cycle', '来源 owner 存在循环')
+  visited.add(key)
+  const parent = rows.get(locator.table)?.find(item => item.id === row[locator.field])
+  return !!parent && isWorldOwned(rows, locator.table, parent, registry, visited)
+}
+
+/** Reusable inside the author confirmation write transaction. Never allocate
+ * source identities during a read or silently include another active Work. */
+export async function captureNarrativeDomainInTransactionV1(input: {
+  scope: WorkspaceScope; owner: NarrativeOwnerV1
+}): Promise<NarrativeDomainCaptureV1> {
+  const registry = currentNarrativeDomainRegistryV1()
+  const scope = await Dexie.Promise.resolve(resolveReadScope({ scope: input.scope }))
+  const owner = ownerDecoderV1(input.owner, 'owner')
+  const world = (await db.worlds.get(scope.worldId))!, work = (await db.works.get(scope.workId))!
+  if (owner.kind === 'work' ? owner.workCode !== work.code
+    : owner.worldCode !== world.code || (owner.sourceWorkCode !== null && owner.sourceWorkCode !== work.code)) {
+    narrativeFail('owner', '领域投影 owner/来源作品与当前作用域不一致')
+  }
+  const specs = PROJECT_TABLES.filter(spec => spec.worldSemantic)
+  const captures = await Dexie.Promise.all(specs.map(spec => spec.table.where('projectId').equals(scope.projectId).toArray()
+    .then(rows => ({ spec, rows: rows as NarrativeDomainRowV1[] }))))
+  const peers = new Map(captures.map(({ spec, rows }) => [spec.name, rows]))
+  const rows = new Map<string, NarrativeDomainRowV1[]>()
+  for (const capture of captures) {
+    const selected: NarrativeDomainRowV1[] = []
+    for (const row of capture.rows) {
+      if (owner.kind === 'world' && owner.sourceWorkCode === null && !isWorldOwned(peers, capture.spec.name, row, registry)) continue
+      // Exclusive-owner sources are accepted only when their actual owner
+      // resolves within the explicit scope; don't use an active-owner fallback.
+      const locator = capture.spec.domainOwner?.locator
+      const actualOwner = locator?.kind === 'exclusive-fields'
+        ? row[locator.worldField] != null ? 'world' : 'work' : undefined
+      if (await Dexie.Promise.resolve(assertRecordInScope(scope, capture.spec.name, row, { owner: actualOwner }))) selected.push(row)
+    }
+    rows.set(capture.spec.name, selected)
+  }
+  peers.set('worlds', await db.worlds.where('projectId').equals(scope.projectId).toArray() as unknown as NarrativeDomainRowV1[])
+  peers.set('works', await db.works.where('projectId').equals(scope.projectId).toArray() as unknown as NarrativeDomainRowV1[])
+  // Projection/confirmation validate the selected source and its references.
+  // Peers are retained only for identity collisions; malformed annotations in
+  // another Work must not make this Work unreadable. Full backup validation
+  // still checks every captured row before export/import.
+  return { scope, owner, rows, peers, registry, worldCode: world.code, workCode: work.code }
+}
+
+export async function captureNarrativeDomainV1(input: {
+  scope: WorkspaceScope; owner: NarrativeOwnerV1
+}): Promise<NarrativeDomainCaptureV1> {
+  return db.transaction('r', narrativeDomainCaptureTablesV1(), async () => await Dexie.Promise.resolve(captureNarrativeDomainInTransactionV1(input)))
+}
+
+function stableOwner(capture: NarrativeDomainCaptureV1, table: string, row: NarrativeDomainRowV1): unknown {
+  if (isWorldOwned(capture.peers, table, row, capture.registry)) return { worldCode: capture.worldCode }
+  return { workCode: capture.workCode }
+}
+
+export function resolveNarrativeDomainGroupV1(capture: NarrativeDomainCaptureV1, table: string,
+  row: NarrativeDomainRowV1): NarrativeDomainRowV1 | null {
+  const spec = narrativeDomainTableV1(capture.registry, table)
+  if (spec.resourceIdentity?.narrativeEntityType === 'world-group') return row
+  const field = spec.homeWorldScoped ? 'homeWorldGroupId' : spec.worldScoped ? 'worldGroupId' : null
+  if ((row.worldGroupId != null && field !== 'worldGroupId') || (row.homeWorldGroupId != null && field !== 'homeWorldGroupId')) {
+    narrativeFail('domain-field', `${table} 子世界字段未由注册表声明`)
+  }
+  if (!field || row[field] == null) return null
+  const group = capture.rows.get('worldGroups')?.find(item => item.id === row[field])
+  if (!group || typeof group.ragDocumentId !== 'string') narrativeFail('source-uid', '所属子世界缺少同作用域稳定身份')
+  return group
+}
+
+/** A source revision commits only registered business fields and typed
+ * annotations. Physical IDs become source UIDs; unrelated UI timestamps and
+ * candidate confidence cannot invalidate or grant semantic authority. */
+export async function hashNarrativeDomainSourceV1(capture: NarrativeDomainCaptureV1, table: string, row: NarrativeDomainRowV1): Promise<string> {
+  const spec = narrativeDomainTableV1(capture.registry, table), projector = spec.worldSemantic?.projector
+  if (!projector || !spec.resourceIdentity) narrativeFail('projector', `${table} 未登记叙事投影`)
+  const business: Record<string, unknown> = {}
+  for (const field of projector.sourceFields) {
+    const foreignKey = spec.exportRemap?.find(remap => remap.field === field)
+    if (row[field] === undefined && !foreignKey) continue
+    // The registered backup codec restores absent optional FK fields as null.
+    // Both mean no reference; that faithful round trip must preserve approval.
+    if (foreignKey && row[field] == null) business[field] = null
+    else if (foreignKey) {
+      const targetSpec = narrativeDomainTableV1(capture.registry, foreignKey.remapVia)
+      const target = capture.rows.get(targetSpec.name)?.find(record => record.id === row[field])
+      if (targetSpec.resourceIdentity) business[field] = { sourceUid: target?.[targetSpec.resourceIdentity.field] ?? null }
+      // Structural chapters/outline coordinates also have resource identity.
+      // Never introduce a numeric fallback into a portable revision.
+      else narrativeFail('source-uid', `${table}.${field} 目标没有稳定资源身份`)
+    } else business[field] = row[field]
+  }
+  const annotations: Record<string, unknown> = {}
+  for (const field of NARRATIVE_DOMAIN_FIELDS_V1) {
+    if (row[field] === undefined) continue
+    if (!projector.annotationFields.includes(field)) narrativeFail('domain-field', `${table}.${field} 未登记`)
+    parseNarrativeDomainFieldV1(field, row[field])
+    if (field === 'narrativeAuthorityV1') continue
+    const normalized = JSON.parse(portableNarrativeDomainFieldJsonV1(field, row[field]))
+    // Subrecords and evidence have persistent keys; array reorder isn't an edit
+    // of their identity. Preserve ordered payload arrays within each item.
+    if (field === 'narrativeDevelopmentsV1' || field === 'narrativeDisclosuresV1') {
+      normalized.sort((a: { semanticSubKey: string }, b: { semanticSubKey: string }) => compareUnicodeCodePointsV1(a.semanticSubKey, b.semanticSubKey))
+    }
+    annotations[field] = normalized
+  }
+  const worldGroup = resolveNarrativeDomainGroupV1(capture, table, row)?.ragDocumentId ?? null
+  return hashNarrativeValueV1({ version: 1, table, sourceUid: row[spec.resourceIdentity.field] ?? null,
+    owner: stableOwner(capture, table, row), worldGroup, business, annotations })
+}
diff --git a/src/lib/world-engine/narrative-domain-evidence.ts b/src/lib/world-engine/narrative-domain-evidence.ts
new file mode 100644
index 00000000..0c43ff2a
--- /dev/null
+++ b/src/lib/world-engine/narrative-domain-evidence.ts
@@ -0,0 +1,83 @@
+import type { NarrativeDomainRegistryV1 } from '../types/narrative-domain-registry'
+import { currentNarrativeDomainRegistryV1, narrativeDomainTableV1 } from './narrative-domain-registry'
+import type { NarrativeDomainEvidenceV1, NarrativeDomainSourceRefV1 } from '../types/narrative-domain'
+import type { NarrativeEvidenceSourceV1, EvidenceSpanV1, VisibilityV1 } from '../types/narrative-ir'
+import type { NarrativeDomainCaptureV1, NarrativeDomainRowV1 } from './narrative-domain-capture'
+import { narrativeDomainReferenceTargetV1 } from '../narrative-domain/references'
+import { hashNarrativeBytesV1, narrativeFail, pointerV1 } from './narrative-json'
+import { verifyNarrativeEvidenceV1 } from './narrative-ir'
+import { intersectNarrativeVisibilityV1 } from '../narrative-domain/visibility'
+
+/** Logical field pointer into a keyed subrecord, never an array position. The
+ * resolver returns the exact stored statement bytes without normalization. */
+export function narrativeDevelopmentStatementPointerV1(subKey: string): string {
+  return `/narrativeDevelopmentsV1/${subKey.replace(/~/g, '~0').replace(/\//g, '~1')}/statement`
+}
+
+function developmentAtPointer(table: string, row: NarrativeDomainRowV1, parts: string[], registry: NarrativeDomainRegistryV1) {
+  if (parts[0] !== 'narrativeDevelopmentsV1') return null
+  if (!narrativeDomainTableV1(registry, table).worldSemantic?.projector?.annotationFields.includes(parts[0])
+    || parts.length !== 3 || parts[2] !== 'statement') narrativeFail('evidence-field', '发展原文必须以持久子记录键定位 statement')
+  const matches = row.narrativeDevelopmentsV1?.filter(item => item.semanticSubKey === parts[1]) ?? []
+  if (matches.length !== 1) narrativeFail('evidence-source', '发展原文子记录不存在或身份重复')
+  return matches[0]
+}
+
+export function narrativeDomainEvidenceVisibilityV1(table: string, row: NarrativeDomainRowV1, fieldPointer: string, registry = currentNarrativeDomainRegistryV1()): VisibilityV1 {
+  const parts = fieldPointer.slice(1).split('/').map(part => part.replace(/~1/g, '/').replace(/~0/g, '~'))
+  const child = developmentAtPointer(table, row, parts, registry)
+  const parent = row.narrativeVisibilityV1 ?? { class: 'unclassified' as const, audienceKeys: [], policyVersion: 'unclassified-v1' }
+  return child?.narrativeVisibilityV1 ? intersectNarrativeVisibilityV1(parent, [child.narrativeVisibilityV1]) : parent
+}
+
+export function resolveNarrativeDomainReferenceV1(capture: NarrativeDomainCaptureV1, reference: NarrativeDomainSourceRefV1): {
+  table: string; row: NarrativeDomainRowV1
+} {
+  const target = narrativeDomainReferenceTargetV1(reference)
+  const row = capture.rows.get(target.table)?.find(record => record.id === target.id)
+  const spec = narrativeDomainTableV1(capture.registry, target.table)
