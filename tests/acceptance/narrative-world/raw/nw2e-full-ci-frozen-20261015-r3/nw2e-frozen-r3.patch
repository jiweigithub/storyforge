+    })().catch(error => { if (active) setMessage(error instanceof Error ? error.message : String(error)) })
+    return () => { active = false }
+  }, [project.id, project.activeWorkId, project.activeWorldId, groupId, refresh])
+  const act = async (action: () => Promise<void>) => {
