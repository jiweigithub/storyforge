+        exactEvidence: queries.length > 0 && queries.every(item => item.status === 'matched' && item.exactEvidenceFound),
+        frozenBytes: !!vector && rows.every(row => (row.prepared as { inputHash?: string } | undefined)?.inputHash === vector.inputHash
